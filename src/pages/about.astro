---
import BaseLayout from "@/layouts/BaseLayout.astro";
import YanoSpeechBubble from "@/components/animation/YanoSpeechBubble.astro";
import islandSea from "@/assets/images/scenery/nakajima-overlook.jpeg";
import kominkaBefore from "@/assets/images/about/kominka-exterior-before.jpeg";
import kominkaWork from "@/assets/images/about/kominka-renovation-floor.jpeg";
import lemonGrove from "@/assets/images/scenery/scenery-lemon-orchard.jpg";
import weekendMigration from "@/assets/images/about/weekend-migration-lemon-harvest.jpeg";
import aboutHeroPhoto from "@/assets/images/about/about-hero-lemon-tree.jpeg";
import whyIGoPhoto from "@/assets/images/about/why-i-go-island.jpg";
import whyIGoRoofPhoto from "@/assets/images/about/why-i-go-roof-work.jpg";

const timeline = [
  {
    date: "2023.02",
    label: "MEETING THE ISLAND",
    title: "船に乗って、中島へ。",
    body: "2022年に愛媛・松山へIターン。田舎の暮らしに関わりたいという思いを抱えながら、翌年、中島を訪れました。橋のない島へ船で渡り、人や風景に出会ったことから、週末ごとに島へ通う日々が始まりました。",
    image: islandSea,
    alt: "瀬戸内海に浮かぶ中島の風景",
  },
  {
    date: "2023.12",
    label: "A HOUSE FOR TWO YEN",
    title: "築100年の家を、2円で受け取る。",
    body: "島で出会った一軒の古民家を譲り受けました。立派な計画があったわけではありません。ただ、長く残ってきたこの家にもう一度風を通し、人が集まれる場所にしたい。その気持ちを頼りに、できることから始めました。",
    image: kominkaBefore,
    alt: "譲り受けた当時の中島の古民家外観",
    imagePosition: "50% 58%",
  },
  {
    date: "2024.06 — 2025.08",
    label: "RENOVATION",
    title: "仲間と手を動かし、家を直す。",
    body: "瓦を下ろし、屋根を張り替え、電気を通し、漆喰を塗る。分からないことは島の人や職人に教わり、仲間と少しずつ進めました。クラウドファンディングにも支えられ、2025年8月、古民家は人を迎えられる場所になりました。",
    image: kominkaWork,
    alt: "床板を外し、仲間と進めた古民家再生の作業風景",
    imagePosition: "50% 50%",
  },
  {
    date: "2025.10",
    label: "100 LEMON TREES",
    title: "切られるはずだった、100本のレモン。",
    body: "古民家再生でお世話になった農家さんが、斜面の畑を管理できなくなりました。「木を切る」と聞き、この風景を残したいと手入れを引き受けることに。草を刈り、枝を見て、実を収穫する週末が始まりました。",
    image: lemonGrove,
    alt: "中島の斜面に広がるレモン畑",
  },
  {
    date: "2026 / NOW",
    label: "WEEKEND MIGRATION",
    title: "暮らしを変えすぎず、関わり続ける。",
    body: "平日は松山や東京で広告の仕事をし、時間が許す週末に中島へ。古民家と畑を行き来しながら、島の人や仲間と手を動かしています。移住するか、しないかだけではない。自分にできる距離から地域と関わる、その一つの形を続けています。",
    image: weekendMigration,
    alt: "中島のレモン畑で収穫を終えた仲間たち",
    imagePosition: "50% 48%",
  },
];
---

<BaseLayout
  title="矢野諭稔について｜矢野、週末移住中。"
  description="平日は広告の仕事、週末は中島へ。古民家再生と100本のレモン畑に関わる矢野諭稔の歩みを紹介します。"
>
  <article class="about-page">
    <YanoSpeechBubble size="map" />
    <header class="about-hero">
      <div class="about-shell about-hero__title-band">
        <div class="about-hero__label" aria-hidden="true">
          <p class="about-hero__display">PROFILE</p>
          <p class="about-hero__byline">SATOSHI YANO</p>
        </div>
      </div>
      <div class="about-hero__panel">
        <div class="about-shell about-hero__grid">
          <figure class="about-hero__photo">
            <img src={aboutHeroPhoto.src} alt="中島のレモン畑で木の手入れをする矢野諭稔" loading="eager" decoding="async" />
          </figure>
          <div class="about-hero__circle">
            <div class="about-hero__circle-content">
              <h1><span>田舎を、もっと</span><span>身近な選択肢に。</span></h1>
              <p class="about-hero__lead">
                <span class="about-hero__lead-line"><span>平日は広告の仕事をしながら、</span><span>週末は愛媛の離島・中島へ。</span></span>
                <span class="about-hero__lead-line"><span>古民家とレモン畑を手入れする、</span><span>週末移住者です。</span></span>
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="about-hero__continuation" aria-hidden="true">
        <span>WHY I GO</span>
        <span class="about-hero__continuation-arrow">↓</span>
      </div>
    </header>

    <section class="about-intro" aria-labelledby="about-intro-title">
      <div class="about-shell">
        <div class="about-intro__story">
          <h2 id="about-intro-title">WHY I GO ?</h2>
          <figure class="about-intro__photo">
            <img
              src={whyIGoPhoto.src}
              alt="海沿いの集落と山々が広がる中島の風景"
              loading="lazy"
              decoding="async"
            />
          </figure>
          <p class="about-intro__opening">
            <span>学生時代に地域で活動するなかで、</span>
            <span>田舎の風景や人の暮らしに惹かれる一方、</span>
            <span>その営みが少しずつ失われていく<span class="about-intro__mobile-break">現実も知りました。</span></span>
          </p>

          <div class="about-intro__emphasis">
            <h3>何かしたい。</h3>
            <p><span>でも、何をしたら</span><span>いいか分からなかった。</span></p>
          </div>

          <figure class="about-intro__photo">
            <img
              src={whyIGoRoofPhoto.src}
              alt="緑に囲まれた島の小道を歩く人たち"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <div class="about-intro__body">
            <p><span>大きなことを掲げるより、</span><span>まずは目の前の風景と関わり続けること。</span></p>
            <p><span>島の人に教わりながら、</span><span>昨日より少し手を動かすこと。</span></p>
            <p><span>その積み重ねが、</span><span>今の活動になっています。</span></p>
          </div>

          <p class="about-intro__conclusion">昨日より、<span>少し手を動かす。</span></p>
        </div>
      </div>
    </section>

    <section class="about-story" aria-labelledby="about-story-title">
      <div class="about-shell">
        <header class="about-story__header">
          <p class="about-kicker">MY STORY</p>
          <h2 id="about-story-title">島と出会ってから、現在まで。</h2>
          <p>最初からできたことは、ひとつもありませんでした。</p>
        </header>
        <ol class="timeline">
          {timeline.map((item, index) => (
            <li class="timeline__item">
              <div class="timeline__rail" aria-hidden="true">
                <span>{String(index + 1).padStart(2, "0")}</span>
              </div>
              <figure class="timeline__image">
                <img
                  src={item.image.src}
                  alt={item.alt}
                  loading="eager"
                  decoding="async"
                  style={item.imagePosition ? `object-position: ${item.imagePosition}` : undefined}
                />
              </figure>
              <div class="timeline__card">
                <div class="timeline__meta"><time>{item.date}</time><span>{item.label}</span></div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="about-now" aria-labelledby="about-now-title">
      <div class="about-shell about-now__card">
        <p class="about-kicker">WHAT I VALUE</p>
        <h2 id="about-now-title">ゆるっと、でも軸を持って。</h2>
        <p>暮らしや仕事を投げ出すのではなく、今の自分にできる範囲で地域と関わり続ける。時間の許す限り、島の人や風景との関係を手入れしていきたいと思っています。</p>
        <div class="about-now__links">
          <a href="/">トップへ戻る <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  :global(body) { background: #36a8e5; color: #18395e; }
  :global(body:has(.about-page)) { --site-frame-space: clamp(8px, .7vw, 10px); }
  .about-page { position: relative; overflow: clip; background: #36a8e5; font-family: "Noto Sans JP", sans-serif; }
  .about-shell { width: min(1160px, calc(100% - clamp(2.5rem, 6vw, 5rem))); margin-inline: auto; }
  .about-kicker { margin: 0; color: #ffe13b; font-size: .78rem; font-weight: 700; line-height: 1.4; letter-spacing: .16em; }
  .about-hero { position: relative; display: block; min-height: 0; padding: 0; background: #36a8e5; }
  .about-hero__title-band { box-sizing: border-box; padding: clamp(7rem, 9vw, 8rem) 0 clamp(1.75rem, 3vw, 2.5rem); }
  .about-hero__label { text-align: center; }
  .about-hero__display { margin: 0 0 .7rem; color: #fff; font-size: clamp(3.5rem, 6vw, 5.5rem); font-weight: 800; line-height: .92; letter-spacing: -.045em; }
  .about-hero__byline { margin: 0; color: #ffe13b; font-size: .9rem; font-weight: 800; line-height: 1.4; letter-spacing: .16em; text-shadow: 0 1px 0 #234a75; }
  .about-hero__panel { padding: clamp(1rem, 2vw, 1.5rem) 0 clamp(1.75rem, 3vw, 2.5rem); background: #36a8e5; }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 32rem) minmax(0, 32rem); gap: clamp(3rem, 4.5vw, 4rem); align-items: center; justify-content: center; }
  .about-hero__photo { position: relative; z-index: 0; justify-self: center; width: 100%; max-width: 32rem; aspect-ratio: 4 / 3; margin: 0; }
  .about-hero__photo::before { position: absolute; z-index: -1; inset: 1rem 1.25rem -1rem -1rem; background: #ffe13b; content: ""; }
  .about-hero__photo img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  .about-hero__circle { box-sizing: border-box; display: grid; place-items: center; justify-self: center; width: min(100%, 32rem); min-height: clamp(20rem, 26vw, 23rem); padding: clamp(3rem, 4vw, 4rem); border-radius: 2.5rem 2.5rem 7rem 2.5rem; background: #050505; }
  .about-hero__circle-content { width: min(100%, 31rem); color: #fff; text-align: center; }
  .about-hero h1 { max-width: 12em; margin: 0 auto 1.5rem; color: #fff; font-family: "Noto Serif JP", serif; font-size: clamp(1.875rem, 2.4vw, 2.25rem); font-weight: 500; line-height: 1.5; letter-spacing: .01em; text-wrap: balance; }
  .about-hero h1 span { display: block; }
  .about-hero__lead { max-width: 34rem; margin: 0 auto; color: rgb(255 255 255 / 88%); font-size: clamp(.9375rem, 1.05vw, 1rem); line-height: 1.9; text-align: center; }
  .about-hero__lead > .about-hero__lead-line { display: block; }
  .about-hero__continuation { display: flex; flex-direction: column; align-items: center; gap: .2rem; padding: 0 0 1.35rem; color: #fff; font-size: .72rem; font-weight: 700; line-height: 1.2; letter-spacing: .18em; }
  .about-hero__continuation-arrow { color: #ffe13b; font-size: 1rem; animation: about-continuation-bob 1.8s ease-in-out infinite; }
  @keyframes about-continuation-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(.3rem); }
  }
  .about-intro { position: relative; overflow: hidden; padding: clamp(5rem, 8vw, 7rem) 0 clamp(6.5rem, 9vw, 8rem); background: #36a8e5; }
  .about-intro > .about-shell {
    position: relative;
    z-index: 1;
    box-sizing: border-box;
    width: min(900px, calc(100% - clamp(3rem, 10vw, 8rem)));
    padding: clamp(4rem, 7vw, 6.5rem) clamp(2.5rem, 7vw, 6rem);
    border: 2px solid #172f50;
    background: #fffdf8;
    box-shadow: clamp(.8rem, 1.6vw, 1.25rem) clamp(.9rem, 1.8vw, 1.4rem) 0 #050505;
    transform: rotate(-.25deg);
  }
  .about-intro > .about-shell::before {
    position: absolute;
    z-index: -2;
    inset: -.9rem 1.25rem auto -1.25rem;
    height: 1.1rem;
    background: #ffe13b;
    content: "";
    transform: rotate(-1deg);
  }
  .about-intro__story { position: relative; z-index: 1; width: min(100%, 44rem); margin: 0 auto; color: #4c5f74; text-align: center; transform: rotate(.25deg); }
  .about-intro__story h2 { margin: 0 0 clamp(2.5rem, 4vw, 3.25rem); color: #111; font-family: "Arial Black", "Helvetica Neue", Arial, sans-serif; font-size: clamp(2.5rem, 4vw, 3.5rem); font-weight: 900; line-height: 1; letter-spacing: -.045em; }
  .about-intro__photo { width: 100%; margin: 0 0 clamp(2.25rem, 4vw, 3rem); }
  .about-intro__photo img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; object-position: center; }
  .about-intro__opening { margin: 0; color: #172f50; font-size: clamp(1rem, 1.2vw, 1.0625rem); font-weight: 500; line-height: 2; letter-spacing: .025em; text-align: center; }
  .about-intro__opening span { display: block; }
  .about-intro__opening .about-intro__mobile-break { display: inline; }
  .about-intro__emphasis { width: min(100%, 38rem); margin: clamp(3rem, 4vw, 3.5rem) auto; padding: clamp(2rem, 3vw, 2.5rem) 1.5rem; border-block: 1px solid rgb(46 149 207 / 34%); }
  .about-intro__emphasis h3 { margin: 0 0 1rem; color: #234a75; font-family: "Noto Serif JP", serif; font-size: clamp(2.5rem, 3.1vw, 2.75rem); font-weight: 500; line-height: 1.4; letter-spacing: .025em; }
  .about-intro__emphasis p { margin: 0; color: #2e7ca8; font-family: "Noto Serif JP", serif; font-size: clamp(1.25rem, 1.7vw, 1.5rem); font-weight: 400; line-height: 1.7; text-wrap: balance; }
  .about-intro__body { display: grid; gap: clamp(1.5rem, 2.2vw, 2rem); }
  .about-intro__body p { margin: 0; color: #172f50; font-size: clamp(1rem, 1.2vw, 1.0625rem); font-weight: 500; line-height: 2; letter-spacing: .025em; text-wrap: balance; }
  .about-intro__conclusion { position: relative; z-index: 0; width: fit-content; max-width: 100%; margin: clamp(3.5rem, 5vw, 4.5rem) auto 0; color: #172f50; font-family: "Noto Serif JP", serif; font-size: clamp(2.25rem, 3.1vw, 2.625rem); font-weight: 500; line-height: 1.5; letter-spacing: .015em; text-wrap: balance; }
  .about-intro__conclusion::after { position: absolute; z-index: -1; right: -.2em; bottom: .18em; left: -.2em; height: .34em; border-radius: 999px; background: #ffe13b; content: ""; opacity: .88; transform: rotate(-1deg); }
  .about-story { padding: clamp(5rem, 6.5vw, 6rem) 0; }
  .about-story__header { margin-bottom: clamp(2.5rem, 4vw, 3.5rem); }
  .about-story__header h2 { margin: .9rem 0 1rem; color: #fff; font-family: "Noto Serif JP", serif; font-size: clamp(2rem, 2.5vw, 2.375rem); font-weight: 500; line-height: 1.45; text-wrap: balance; }
  .about-story__header > p:last-child { margin: 0; color: rgb(255 255 255 / 78%); }
  .timeline { display: grid; gap: clamp(2.5rem, 3.5vw, 3rem); margin: 0; padding: 0; list-style: none; }
  .timeline__item { position: relative; display: grid; grid-template-columns: 3.5rem minmax(0, .9fr) minmax(20rem, 1.1fr); gap: clamp(1.5rem, 3vw, 3rem); align-items: stretch; }
  .timeline__rail { align-self: stretch; position: relative; display: flex; justify-content: center; padding-top: .2rem; }
  .timeline__rail::after { position: absolute; top: 2.9rem; bottom: calc(-3rem - 1px); left: 50%; width: 1px; background: rgb(255 255 255 / 40%); content: ""; }
  .timeline__item:last-child .timeline__rail::after { display: none; }
  .timeline__rail span { z-index: 1; display: grid; place-items: center; width: 3.1rem; height: 3.1rem; border: 2px solid #fff; border-radius: 50%; background: #36a8e5; color: #fff; font-size: .72rem; letter-spacing: .08em; }
  .timeline__image { margin: 0; padding: .45rem; background: #fffdf8; box-shadow: .55rem .6rem 0 rgb(20 78 119 / 18%); transform: rotate(-1deg); }
  .timeline__item:nth-child(even) .timeline__image { transform: rotate(1deg); }
  .timeline__image img { display: block; width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .timeline__card { display: flex; flex-direction: column; justify-content: center; min-height: 100%; padding: clamp(1.75rem, 2.5vw, 2.5rem); border-radius: .2rem; background: #fffdf8; box-shadow: .55rem .6rem 0 #ffe13b; }
  .timeline__meta { display: flex; flex-wrap: wrap; gap: .55rem 1rem; align-items: center; margin-bottom: 1rem; color: #2d88bc; font-size: .68rem; letter-spacing: .11em; }
  .timeline__meta time { padding: .3rem .55rem; background: #ffe13b; color: #234a75; font-weight: 500; }
  .timeline__card h3 { margin: 0 0 1rem; color: #234a75; font-family: "Noto Serif JP", serif; font-size: clamp(1.375rem, 1.65vw, 1.5rem); font-weight: 500; line-height: 1.5; text-wrap: pretty; }
  .timeline__card p { max-width: 31rem; margin: 0; color: #4c5f74; font-size: 1rem; line-height: 1.9; }
  .about-now { padding: 0 0 clamp(5rem, 6.5vw, 6rem); }
  .about-now__card { box-sizing: border-box; padding: clamp(3rem, 4vw, 4rem); background: #234a75; box-shadow: .8rem .85rem 0 #ffe13b; }
  .about-now__card h2 { margin: 1rem 0 1.4rem; color: #fff; font-family: "Noto Serif JP", serif; font-size: clamp(2rem, 2.5vw, 2.375rem); font-weight: 500; line-height: 1.45; text-wrap: balance; }
  .about-now__card > p:nth-of-type(2) { max-width: 46rem; margin: 0; color: rgb(255 255 255 / 82%); line-height: 2; }
  .about-now__links { display: flex; flex-wrap: wrap; gap: .9rem; margin-top: 2.5rem; }
  .about-now__links a { box-sizing: border-box; display: flex; justify-content: space-between; align-items: center; gap: 2rem; min-width: 15rem; min-height: 52px; padding: .65rem 1.1rem; border: 2px solid #fff; background: #fffdf8; color: #234a75; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
  .about-now__links a:hover, .about-now__links a:focus-visible { box-shadow: .28rem .32rem 0 #ffe13b; transform: translate(-.12rem, -.12rem); }
  @media (max-width: 820px) {
    .about-page :global(.yano-brand) {
      --brand-yano-height-desktop: 104px !important;
      --brand-yano-height-mobile: 104px !important;
    }
    .about-hero__title-band { padding: 12rem 0 2.5rem; }
    .about-hero__grid { grid-template-columns: 1fr; }
    .about-hero__photo { max-width: 32rem; }
    .about-hero__circle { width: min(100%, 32rem); min-height: 0; }
    .timeline__item { grid-template-columns: 3.5rem 1fr; }
    .timeline__image, .timeline__card { grid-column: 2; }
    .timeline__image { grid-row: 1; }
    .timeline__card { grid-row: 2; }
    .timeline__rail { grid-row: 1 / 3; }
  }
  @media (max-width: 600px) {
    :global(body:has(.about-page)) { --site-frame-space: 5px; }
    .about-shell { width: min(100% - 40px, 1180px); }
    .about-kicker { font-size: .72rem; }
    .about-hero__title-band { padding: 11.75rem 0 2rem; }
    .about-hero__panel { padding: .75rem 0 2.25rem; }
    .about-hero__grid { gap: 2.25rem; }
    .about-hero__display { font-size: clamp(3rem, 14vw, 3.5rem); }
    .about-hero__byline { font-size: .8rem; }
    .about-hero__photo { width: 90%; max-width: 22rem; }
    .about-hero__photo::before { inset: .75rem .75rem -.75rem -.75rem; }
    .about-hero__circle { width: 100%; max-width: 23rem; padding: 2rem 1.5rem; border-radius: 1.75rem 1.75rem 4.5rem 1.75rem; }
    .about-hero h1 { max-width: 10.5em; margin-bottom: 1.1rem; font-size: clamp(1.625rem, 7.2vw, 1.875rem); line-height: 1.5; }
    .about-hero__lead { font-size: clamp(.875rem, 3.8vw, .9375rem); line-height: 1.9; }
    .about-hero__lead-line > span { display: block; }
    .about-hero__continuation { padding-bottom: 1.15rem; }
    .about-intro { padding-block: 4rem 5rem; }
    .about-intro > .about-shell {
      width: calc(100% - 34px);
      padding: 3.5rem 1.35rem 4rem;
      box-shadow: .55rem .65rem 0 #050505;
      transform: none;
    }
    .about-intro > .about-shell::before {
      inset: -.55rem .75rem auto -.65rem;
      height: .7rem;
    }
    .about-intro__story { width: min(100%, 34rem); }
    .about-intro__story { transform: none; }
    .about-intro__story h2 { margin-bottom: 2rem; font-size: clamp(2.1rem, 11vw, 2.7rem); }
    .about-intro__photo { margin-bottom: 1.75rem; }
    .about-intro__opening { font-size: .875rem; line-height: 1.9; letter-spacing: 0; }
    .about-intro__opening span { display: block; }
    .about-intro__opening .about-intro__mobile-break { display: block; }
    .about-intro__emphasis { margin-block: 2.5rem; padding: 1.75rem .25rem; }
