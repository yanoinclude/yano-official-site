---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/content/pages/site";
import YanoSpeechBubble from "@/components/animation/YanoSpeechBubble.astro";
import ferryImage from "@/assets/images/home/nakajima-ferry-cutout.png";
import yanoImage from "@/assets/images/home/yano-walking-cutout.png";
import nakajimaAerialImage from "@/assets/images/events/nakajima-bbq-2026/nakajima-aerial.jpg";
import watermelonBeachImage from "@/assets/images/events/nakajima-bbq-2026/watermelon-beach.jpg";

const outboundFerries = [
  {
    number: "01",
    label: "朝から島を満喫",
    departure: "6:55",
    arrival: "8:15",
    port: "大浦港",
    access: "軽トラで約10分",
  },
  {
    number: "02",
    label: "いちばんおすすめ",
    departure: "9:10",
    arrival: "10:00",
    port: "神浦港",
    access: "古民家まで徒歩3分",
    recommended: true,
  },
  {
    number: "03",
    label: "乗り遅れても大丈夫",
    departure: "10:10",
    arrival: "11:30",
    port: "大浦港",
    access: "軽トラで約10分",
  },
];

const returnFerries = [
  {
    departure: "15:39",
    port: "神浦港",
    arrival: "16:30",
  },
  {
    departure: "17:10",
    port: "大浦港",
    arrival: "19:00",
  },
];
---

<BaseLayout
  title="中島BBQ＆ビーチフラッグ大会 2026"
  description="2026年8月8日、中島・矢野の古民家でBBQとビーチフラッグ大会。スイカ割りもしたい、島の夏休みイベントです。"
  canonical="/events/nakajima-bbq-2026/"
  preloadImages={[nakajimaAerialImage.src, watermelonBeachImage.src]}
>
  <article class="bbq-event">
    <header class="bbq-hero">
      <YanoSpeechBubble />
      <img class="bbq-hero__background" src={nakajimaAerialImage.src} alt="海から見た中島の集落と山々" />
      <span class="bbq-hero__shade" aria-hidden="true"></span>
      <div class="bbq-hero__copy">
        <p class="bbq-kicker">YANO'S ISLAND SUMMER / NAKAJIMA</p>
        <p class="bbq-hero__date"><strong>2026.8.8</strong><span>SAT</span></p>
        <h1><span>中島BBQ</span><small>and</small><span class="bbq-title-keep">ビーチフラッグ大会</span></h1>
        <p class="bbq-hero__aside">（スイカ割りしたい）</p>
        <p class="bbq-hero__lead">船に乗って、<br />島の夏休みへ。</p>
        <div class="bbq-hero__facts" aria-label="イベント概要">
          <p><span>TIME</span><strong>10:00–16:30</strong></p>
          <p><span>PLACE</span><strong>矢野の古民家</strong></p>
          <p><span>FEE</span><strong>2,000円</strong><small>＋交通費</small></p>
        </div>
      </div>
      <div class="bbq-hero__scene" aria-hidden="true">
        <figure class="bbq-hero__photo">
          <img src={watermelonBeachImage.src} alt="" />
          <figcaption>スイカ割り、したい。</figcaption>
        </figure>
      </div>
      <a class="bbq-scroll" href="#details">くわしく見る <span>↓</span></a>
    </header>

    <section class="bbq-intro" id="details">
      <div class="bbq-shell bbq-intro__grid">
        <div>
          <p class="bbq-kicker">ABOUT THE DAY</p>
          <h2>走って、焼いて、<br />夏を遊ぶ一日。</h2>
        </div>
        <div class="bbq-intro__body">
          <p>中島の古民家に集まったら、まずは海辺でビーチフラッグ大会。思いっきり走ったあとは、みんなでBBQを楽しみます。</p>
          <p>スイカが手に入ったら、スイカ割りも。きっちり決めすぎず、島の時間を一緒に楽しみましょう。</p>
        </div>
      </div>
      <div class="bbq-marquee" aria-hidden="true">
        <span>BBQ</span><i>●</i><span>BEACH FLAGS</span><i>●</i><span>WATERMELON</span><i>●</i><span>NAKAJIMA</span>
      </div>
    </section>

    <section class="bbq-info" aria-labelledby="info-title">
      <div class="bbq-shell">
        <header class="bbq-section-heading">
          <p class="bbq-kicker">EVENT INFO</p>
          <h2 id="info-title">まずは、これだけ。</h2>
        </header>
        <div class="bbq-info__grid">
          <article><span>01</span><p>日時</p><h3>8月8日（土）</h3><strong>10:00〜16:30</strong></article>
          <article><span>02</span><p>場所</p><h3>矢野の古民家</h3><strong>神浦港から徒歩3分</strong></article>
          <article><span>03</span><p>参加費</p><h3>2,000円</h3><strong>交通費は別途</strong></article>
        </div>
      </div>
    </section>

    <section class="bbq-schedule" aria-labelledby="schedule-title">
      <div class="bbq-shell bbq-schedule__grid">
        <header>
          <p class="bbq-kicker">DAY SCHEDULE</p>
          <h2 id="schedule-title">当日の流れ</h2>
          <p>ビーチフラッグで思いっきり走ったあと、みんなでBBQを楽しみます。</p>
        </header>
        <ol class="bbq-timeline">
          <li><time>10:00</time><div><h3>神浦港到着</h3><p>港から古民家までは徒歩3分です。</p></div></li>
          <li><time>10:15</time><div><h3>古民家に集合</h3><p>荷物を置いて、海へ向かう準備をします。</p></div></li>
          <li class="bbq-timeline__highlight"><time>11:30</time><div><h3>ビーチフラッグ大会</h3><p>お昼ごはんの前に、砂浜でひと勝負。</p></div></li>
          <li><time>12:30</time><div><h3>みんなでBBQ</h3><p>持ち寄った「焼きたいもの」も一緒に焼きます。</p></div></li>
          <li><time>14:00</time><div><h3>スイカ割り（したい）</h3><p>スイカが手に入ったら開催します。</p></div></li>
          <li><time>16:00</time><div><h3>自由時間・片付け</h3><p>帰り支度をしながら、のんびり過ごします。</p></div></li>
          <li><time>16:30</time><div><h3>終了</h3><p>都合のよいフェリーでお帰りください。</p></div></li>
        </ol>
      </div>
    </section>

    <section class="bbq-bring" aria-labelledby="bring-title">
      <div class="bbq-shell bbq-bring__grid">
        <header>
          <p class="bbq-kicker">WHAT TO BRING</p>
          <h2 id="bring-title">持ってくるもの</h2>
          <p>島で思いっきり遊べる準備でどうぞ。</p>
        </header>
        <ol>
          <li><span>01</span><div><h3>汚れてもいい服</h3><p>BBQも砂浜も、気にせず楽しめる格好で。</p></div></li>
          <li><span>02</span><div><h3>BBQで焼きたいもの一つ</h3><p>肉、野菜、魚、変わり種。好きなものを持ち寄ろう。</p></div></li>
        </ol>
      </div>
    </section>

    <section class="bbq-access" id="ferry" aria-labelledby="ferry-title">
      <div class="bbq-shell">
        <header class="bbq-section-heading bbq-section-heading--access">
          <div>
            <p class="bbq-kicker">FERRY / TO NAKAJIMA</p>
            <h2 id="ferry-title">行きのフェリー</h2>
          </div>
          <p>三津浜港から中島へ。<br />②のフェリーがいちばんおすすめです。</p>
        </header>
        <div class="ferry-list">
          {outboundFerries.map((ferry) => (
            <article class:list={["ferry-card", { "ferry-card--recommended": ferry.recommended }]}>
              <div class="ferry-card__number">{ferry.number}</div>
              <div class="ferry-card__label">
                {ferry.recommended && <span>おすすめ</span>}
                <p>{ferry.label}</p>
              </div>
              <div class="ferry-card__route">
                <div><small>三津浜港 発</small><strong>{ferry.departure}</strong></div>
                <span class="ferry-card__line"><i></i><b>→</b></span>
                <div><small>{ferry.port} 着</small><strong>{ferry.arrival}</strong></div>
              </div>
              <p class="ferry-card__access">{ferry.access}</p>
            </article>
          ))}
        </div>
        <div class="bbq-reassurance">
          <img src={ferryImage.src} alt="中島へ向かうフェリー" />
          <div><p>DON'T WORRY!</p><h3>乗り遅れても大丈夫。</h3><span>大浦港には軽トラで迎えに行きます。</span></div>
        </div>
        <a class="bbq-map-link" href="https://share.google/JJNlyhVfRPplGMd0r" target="_blank" rel="noopener noreferrer">
          三津浜港を地図で見る <span>↗</span>
        </a>
      </div>
    </section>

    <section class="bbq-return" aria-labelledby="return-title">
      <div class="bbq-shell bbq-return__grid">
        <header>
          <p class="bbq-kicker">FERRY / BACK TO MATSUYAMA</p>
          <h2 id="return-title">帰りのフェリー</h2>
          <p>都合のよいフェリーで、自由にお帰りください。</p>
        </header>
        <div class="return-list">
          {returnFerries.map((ferry) => (
            <article>
              <div><small>{ferry.port} 発</small><strong>{ferry.departure}</strong></div>
              <span>→</span>
              <div><small>三津浜港 着</small><strong>{ferry.arrival}</strong></div>
            </article>
          ))}
          <p class="bbq-timetable-note">※運航時刻は変更になる場合があります。乗船前に最新の時刻表をご確認ください。</p>
        </div>
      </div>
    </section>

    <section class="bbq-cta" aria-labelledby="join-title">
      <div class="bbq-cta__sun" aria-hidden="true"></div>
      <img class="bbq-cta__yano" src={yanoImage.src} alt="手を振る矢野のイラスト" />
      <div class="bbq-cta__copy">
        <p class="bbq-kicker">SEE YOU ON THE ISLAND!</p>
        <h2 id="join-title">島の夏休み、<br />一緒にどうですか？</h2>
        <p>参加の連絡や気になることは、<br />InstagramのDMからどうぞ。</p>
        <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer">Instagramで連絡する <span>↗</span></a>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .bbq-event{--ink:#203b60;--yellow:#ffe500;--paper:#fffdf4;--sea:#a9d7e5;color:var(--ink);background:var(--paper);font-family:var(--font-island-body)}
  .bbq-shell{width:min(1180px,calc(100% - 2 * clamp(1.25rem,5vw,4.5rem)));margin-inline:auto}
  .bbq-kicker{margin:0;font:500 .76rem/1.2 var(--font-island-accent);letter-spacing:.17em}
  .bbq-hero{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,.82fr);min-height:calc(100svh - 76px);padding:clamp(4rem,7vw,7rem) max(clamp(1.25rem,5vw,5rem),calc((100vw - 1300px)/2));overflow:hidden;background:linear-gradient(180deg,#fffdf4 0 74%,#a9d7e5 74%)}
  .bbq-hero__copy{position:relative;z-index:3;align-self:center}.bbq-hero__date{display:flex;align-items:center;gap:.8rem;margin:1.5rem 0 .7rem}.bbq-hero__date strong{font:500 clamp(2.3rem,5vw,5rem)/.9 var(--font-island-accent);letter-spacing:-.05em}.bbq-hero__date span{padding:.32rem .45rem;border:2px solid var(--ink);background:var(--yellow);font-weight:500}
  .bbq-hero h1{display:flex;flex-direction:column;align-items:flex-start;margin:0;font:500 clamp(2.55rem,5.25vw,5.6rem)/1.06 var(--font-island-heading);letter-spacing:-.065em}.bbq-hero h1 small{margin:.05em 0 .05em 30%;font:italic 500 clamp(1rem,1.8vw,1.6rem)/1 var(--font-island-accent);letter-spacing:.08em}.bbq-hero__aside{display:inline-block;margin:.8rem 0 0 28%;padding:.3rem .75rem;border-bottom:4px solid var(--yellow);font-weight:500;transform:rotate(-2deg)}
  .bbq-hero__lead{margin:clamp(1.5rem,4vw,3rem) 0 0;font:500 clamp(1.3rem,2.3vw,2rem)/1.55 var(--font-island-heading)}
  .bbq-hero__facts{display:flex;gap:clamp(1.2rem,3vw,2.8rem);margin-top:2rem}.bbq-hero__facts p{display:grid;gap:.25rem;margin:0}.bbq-hero__facts span{font:.68rem var(--font-island-accent);letter-spacing:.15em}.bbq-hero__facts strong{font-size:clamp(.92rem,1.3vw,1.08rem)}.bbq-hero__facts small{font-size:.72rem}
  .bbq-hero__scene{position:relative;z-index:2;align-self:stretch;min-height:560px}.bbq-sun{position:absolute;top:5%;right:-8%;width:min(29vw,420px);aspect-ratio:1;border-radius:50%;background:var(--yellow)}.bbq-hero__ferry{position:absolute;top:12%;left:-6%;width:min(27vw,370px);filter:drop-shadow(0 15px 15px rgb(31 59 96/.15))}.bbq-hero__house{position:absolute;right:0;bottom:7%;width:min(33vw,500px);filter:drop-shadow(0 20px 18px rgb(31 59 96/.18))}.bbq-hero__yano{position:absolute;z-index:3;right:3%;bottom:0;width:min(12vw,165px);filter:drop-shadow(0 12px 9px rgb(31 59 96/.18))}.bbq-hero__speech{position:absolute;z-index:4;right:4%;bottom:35%;margin:0;padding:.7rem 1rem;border:2px solid var(--ink);border-radius:50%;background:white;font-weight:500;transform:rotate(4deg)}
  .bbq-watermelon{position:absolute;left:7%;bottom:4%;width:110px;aspect-ratio:1;border:3px solid var(--ink);border-radius:50%;overflow:hidden;background:#ef665e;transform:rotate(-8deg)}.bbq-watermelon:after{content:"";position:absolute;inset:12px;border:3px solid #fff7c5;border-radius:50%}.bbq-watermelon span,.bbq-watermelon span:before,.bbq-watermelon span:after{position:absolute;z-index:2;width:5px;height:9px;border-radius:50%;background:var(--ink);content:""}.bbq-watermelon span{top:35%;left:48%}.bbq-watermelon span:before{top:22px;left:-28px}.bbq-watermelon span:after{top:25px;left:26px}.bbq-hero__wave{position:absolute;z-index:1;bottom:-1%;left:-3%;width:110%;height:27%;object-fit:cover;opacity:.45}.bbq-scroll{position:absolute;z-index:5;right:2rem;bottom:2rem;display:flex;align-items:center;gap:.8rem;color:var(--ink);font-size:.78rem;letter-spacing:.08em;text-decoration:none;writing-mode:vertical-rl}.bbq-scroll span{font-size:1.3rem}
  .bbq-hero{isolation:isolate;grid-template-columns:minmax(0,1.05fr) minmax(320px,.65fr);gap:clamp(2rem,5vw,5rem);min-height:calc(100svh - 76px);background:#203b60}
  .bbq-hero__background{position:absolute;z-index:-3;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 54%}
  .bbq-hero__shade{position:absolute;z-index:-2;inset:0;background:linear-gradient(90deg,rgb(20 43 71/.68) 0%,rgb(20 43 71/.3) 52%,rgb(20 43 71/.08) 100%)}
  .bbq-hero__copy{max-width:720px;padding:clamp(1.5rem,3vw,2.8rem);border:1px solid rgb(255 255 255/.72);background:rgb(255 253 244/.92);box-shadow:0 24px 60px rgb(13 38 67/.2);backdrop-filter:blur(8px)}
  .bbq-hero :global(.yano-brand){top:clamp(1rem,2vw,1.75rem);left:clamp(1rem,2.5vw,2.5rem)}.bbq-hero :global(.yano-brand__bubble){font-size:0}.bbq-hero :global(.yano-brand__bubble):before{content:"BBQしよ〜";font-size:clamp(1.2rem,1.8vw,1.55rem)}.bbq-hero :global(.yano-brand__character){--brand-yano-height:clamp(108px,9vw,126px)}
  .bbq-hero__copy{margin-top:clamp(5rem,8vw,7.5rem)}
  .bbq-title-keep{white-space:nowrap}
  .bbq-hero__scene{display:flex;align-items:center;justify-content:center;min-height:580px}
  .bbq-hero__photo{position:relative;width:min(100%,390px);margin:0;transform:rotate(2.5deg);filter:drop-shadow(0 24px 32px rgb(13 38 67/.35))}
  .bbq-hero__photo img{display:block;width:100%;aspect-ratio:3/4;border:10px solid #fff;object-fit:cover}
  .bbq-hero__photo figcaption{position:absolute;right:-1rem;bottom:1.2rem;padding:.65rem .9rem;background:var(--yellow);color:var(--ink);font-weight:500;transform:rotate(-4deg)}
  .bbq-hero__yano{right:-1.5rem;bottom:1rem;width:min(11vw,145px)}
  .bbq-hero__speech{right:-1rem;bottom:28%}
  .bbq-scroll{color:white}
  .bbq-intro{padding:var(--island-section) 0 0;background:#fff}.bbq-intro__grid{display:grid;grid-template-columns:.75fr 1fr;gap:clamp(3rem,8vw,8rem)}.bbq-intro h2,.bbq-section-heading h2,.bbq-bring h2,.bbq-return h2,.bbq-cta h2{margin:.8rem 0 0;font:500 clamp(2rem,4vw,4rem)/1.35 var(--font-island-heading);letter-spacing:-.045em}.bbq-intro__body{max-width:36rem;padding-top:2rem}.bbq-intro__body p{margin:0 0 1.3rem;font-size:clamp(1rem,1.3vw,1.13rem);line-height:2}.bbq-marquee{display:flex;align-items:center;gap:2.2rem;margin-top:var(--island-section);padding:1.1rem 0;overflow:hidden;background:var(--yellow);font:500 clamp(1.2rem,2.8vw,2.4rem)/1 var(--font-island-accent);white-space:nowrap}.bbq-marquee i{font-size:.55em}.bbq-marquee span:first-child{margin-left:-1rem}
  .bbq-info{padding:var(--island-section) 0;background:#f4f1e9}.bbq-section-heading{margin-bottom:clamp(2.5rem,5vw,4rem)}.bbq-info__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.2rem}.bbq-info__grid article{position:relative;min-height:270px;padding:clamp(1.5rem,3vw,2.5rem);border:1px solid rgb(32 59 96/.22);background:#fff}.bbq-info__grid article>span{position:absolute;top:1.3rem;right:1.5rem;font:500 2.8rem/1 var(--font-island-accent);color:rgb(32 59 96/.15)}.bbq-info__grid article>p{margin:0 0 4rem;font-size:.75rem;letter-spacing:.13em}.bbq-info__grid h3{margin:0 0 .75rem;font:500 clamp(1.5rem,2.5vw,2.4rem)/1.35 var(--font-island-heading)}.bbq-info__grid strong{font-size:.9rem}
  .bbq-schedule{padding:var(--island-section) 0;background:#fff}.bbq-schedule__grid{display:grid;grid-template-columns:.7fr 1fr;gap:clamp(3rem,8vw,8rem)}.bbq-schedule header{position:sticky;top:120px;align-self:start}.bbq-schedule h2{margin:.8rem 0 1.5rem;font:500 clamp(2rem,4vw,4rem)/1.35 var(--font-island-heading);letter-spacing:-.045em}.bbq-schedule header>p:last-child{max-width:27rem;margin:0;line-height:1.9}.bbq-timeline{position:relative;margin:0;padding:0;list-style:none}.bbq-timeline:before{position:absolute;top:1rem;bottom:1rem;left:5.25rem;width:1px;background:rgb(32 59 96/.24);content:""}.bbq-timeline li{position:relative;display:grid;grid-template-columns:4rem 1fr;gap:2.5rem;padding:0 0 2.2rem}.bbq-timeline li:before{position:absolute;top:.42rem;left:4.98rem;width:.58rem;aspect-ratio:1;border:2px solid var(--ink);border-radius:50%;background:#fff;content:""}.bbq-timeline time{font:500 1.05rem var(--font-island-accent)}.bbq-timeline h3{margin:0 0 .45rem;font:500 clamp(1.15rem,1.8vw,1.5rem) var(--font-island-heading)}.bbq-timeline p{margin:0;color:var(--island-muted);font-size:.88rem;line-height:1.7}.bbq-timeline__highlight div{margin-top:-.8rem;padding:1rem 1.2rem;background:var(--yellow)}.bbq-timeline__highlight:before{background:var(--yellow)}
  .bbq-bring{padding:var(--island-section) 0;background:var(--ink);color:white}.bbq-bring__grid{display:grid;grid-template-columns:.7fr 1fr;gap:clamp(3rem,8vw,8rem)}.bbq-bring header>p:last-child{line-height:1.8}.bbq-bring ol{margin:0;padding:0;list-style:none}.bbq-bring li{display:grid;grid-template-columns:4rem 1fr;gap:1.5rem;padding:2rem 0;border-top:1px solid rgb(255 255 255/.35)}.bbq-bring li:last-child{border-bottom:1px solid rgb(255 255 255/.35)}.bbq-bring li>span{font:500 .85rem var(--font-island-accent);color:var(--yellow)}.bbq-bring h3{margin:0 0 .65rem;font:500 clamp(1.25rem,2vw,1.7rem) var(--font-island-heading)}.bbq-bring li p{margin:0;color:rgb(255 255 255/.75);line-height:1.8}
