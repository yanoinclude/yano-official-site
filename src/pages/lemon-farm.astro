---
import BaseLayout from "@/layouts/BaseLayout.astro";
import YanoSpeechBubble from "@/components/animation/YanoSpeechBubble.astro";
import heroLemonGrove from "@/assets/images/hero-user-lemon-grove.jpg";
import lemonBasket from "@/assets/images/scenery/nakajima-lemon-basket.jpeg";
import weekendLemonJuice from "@/assets/images/product/weekend-lemon-juice.png";
import lemonTasting from "@/assets/images/lemon-farm/lemon-tasting.jpeg";
import youngLemon from "@/assets/images/lemon-farm/young-lemon.jpeg";
import harvestBoy from "@/assets/images/lemon-farm/harvest-boy.jpeg";
import lemonBlossom from "@/assets/images/lemon-farm/lemon-blossom.jpeg";
import harvestFriends from "@/assets/images/lemon-farm/harvest-friends.jpeg";
import orchardGroup from "@/assets/images/lemon-farm/orchard-group.jpeg";
import harvestCrates from "@/assets/images/lemon-farm/harvest-crates.jpeg";
import orchardRest from "@/assets/images/lemon-farm/orchard-rest.jpeg";

const seasons = [
  {
    label: "SPRING",
    title: "春",
    body: "花が咲き、新しい枝が伸びる季節。木の状態を確認しながら、枝や葉の混み具合を整えます。",
  },
  {
    label: "SUMMER",
    title: "夏",
    body: "草が大きく伸びる季節。草を刈り、木の足元を整え、レモンに光と風が届く環境をつくります。",
  },
  {
    label: "AUTUMN",
    title: "秋",
    body: "少しずつ実が大きくなる季節。色や形、枝の状態を見ながら、収穫までの変化を見守ります。",
  },
  {
    label: "WINTER",
    title: "冬",
    body: "黄色く色づいたレモンを、ひとつずつ手で収穫します。収穫した実は、生果や果汁など、次の楽しみへつなげます。",
  },
];

const freshLemon = {
  status: "preparing" as "preparing" | "available",
  url: "",
};

const weekendLemonJuiceUrl =
  "https://weekend-island-shop.square.site/product/-1-150ml/5LMEMCNOIEPUQVKJZFIYI3M2?cs=true&cst=custom";

const farmScenes = [
  { image: harvestFriends, alt: "レモン畑で収穫かごを持つ仲間たち", caption: "仲間と迎えた、収穫の日。" },
  { image: lemonBlossom, alt: "葉の間で咲く白いレモンの花", caption: "春、白い花がひらく。" },
  { image: youngLemon, alt: "枝に実った小さな緑色のレモン", caption: "花のあとに生まれた、小さな実。" },
  { image: orchardGroup, alt: "レモン畑に集まった収穫メンバー", caption: "斜面の畑に、笑い声が増える。" },
  { image: harvestCrates, alt: "収穫したレモンを黄色いかごへ運ぶ様子", caption: "ひとつずつ、かごへ。" },
  { image: harvestBoy, alt: "収穫した大きなレモンを見せる少年", caption: "形も大きさも、それぞれ。" },
  { image: orchardRest, alt: "収穫したレモンを囲んで畑で休む二人", caption: "木陰で、ひと休み。" },
  { image: lemonTasting, alt: "畑で採れたレモンを味見する男性", caption: "採れたてを、その場で味わう。" },
];
---

<BaseLayout
  title="レモン農園｜矢野、週末移住中。"
  description="中島のレモン畑で続ける、手入れから収穫、商品になるまでの週末の営みを紹介します。"
  preloadImages={["/images/lemon-farm/yano-lemon-tree-cropped.png"]}
>
  <article class="farm-page">
    <YanoSpeechBubble character="mowing" size="map" />
    <header class="farm-hero">
      <div class="farm-hero__copy">
        <p class="eyebrow">LEMON FARM</p>
        <h1>島の風と光で、<br /><span class="word-keep">レモンを育てる。</span></h1>
        <p class="farm-hero__lead">
          中島の斜面に広がるレモン畑。<br />週末ごとに木と向き合い、季節の変化を手で確かめています。
        </p>
        <a class="farm-hero__cta" href="#farm-story">レモン畑をのぞく <span aria-hidden="true">→</span></a>
      </div>
      <div class="farm-stage" aria-label="島の自然光の中で畑を手入れする矢野">
        <span class="farm-stage__ground-light" aria-hidden="true"></span>
        <span class="farm-stage__shadow farm-stage__shadow--person" aria-hidden="true"></span>
        <span class="farm-stage__shadow farm-stage__shadow--tool" aria-hidden="true"></span>
        <span class="farm-stage__shadow farm-stage__shadow--tree" aria-hidden="true"></span>
        <img
          class="farm-stage__art"
          src="/images/lemon-farm/yano-lemon-tree-cropped.png"
          alt="草刈機を持つ矢野と実をつけたレモンの木のイラスト"
          width="1175"
          height="949"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          data-farm-hero-art
        />
      </div>
    </header>

    <section class="farm-story" id="farm-story" aria-labelledby="farm-story-title">
      <div class="farm-story__heading">
        <p class="eyebrow">STORY OF THE FARM</p>
        <h2 id="farm-story-title">切られるはずだった、<br />100本のレモンの木。</h2>
      </div>
      <figure class="farm-story__photo">
        <img src={heroLemonGrove.src} alt="中島の斜面に広がるレモン畑" loading="eager" />
      </figure>
      <div class="farm-story__body">
        <p>古民家の隣にあった、レモン畑。</p>
        <p>長く畑を守ってきた農家さんは、古民家再生を始めた頃から、活動を一番近くで見守ってくれた人でした。</p>
        <p>けれど、足を痛めてから、斜面での作業を続けることが難しくなっていきました。</p>
        <blockquote>「もう、レモンの木は全部切る」</blockquote>
        <p>そう聞いたとき、この風景を残したいと思いました。</p>
        <p>農業は初めて。それでも約100本の木を引き継ぎ、週末ごとに島へ通いながら、草を刈り、枝を見て、少しずつ手入れを続けています。</p>
      </div>
    </section>

    <section class="farm-facts" aria-labelledby="farm-facts-title">
      <header>
        <p class="eyebrow">ABOUT THE FARM</p>
        <h2 id="farm-facts-title"><span class="farm-facts__title-line">週末ごとに向き合う、</span><br />中島のレモン畑。</h2>
      </header>
      <dl>
        <div><dt>LOCATION</dt><dd>愛媛県松山市・中島（神浦地区）</dd></div>
        <div><dt>LEMON TREES</dt><dd><b>約100本、12年生</b></dd></div>
        <div><dt>WEEKEND FARMING</dt><dd>無農薬栽培</dd></div>
        <div><dt>HARVEST</dt><dd>11月頃〜翌年5月頃まで</dd></div>
      </dl>
    </section>

    <section class="farm-seasons" aria-labelledby="farm-seasons-title">
      <header>
        <p class="eyebrow">SEASONS OF THE FARM</p>
        <h2 id="farm-seasons-title">週末を重ねて、<br />次の実りを待つ。</h2>
        <p>毎週できることは、決して多くありません。それでも畑へ通い、木の変化を確かめながら、その季節に必要な手入れを重ねています。</p>
      </header>
      <ol>
        {seasons.map((season) => (
          <li>
            <span class="farm-seasons__mark">{season.title}</span>
            <small>{season.label}</small>
            <p>{season.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="farm-gallery" aria-labelledby="gallery-title">
      <div class="farm-gallery__heading">
        <p class="eyebrow">SCENES FROM THE FARM</p>
        <h2 id="gallery-title">畑の景色</h2>
      </div>
      <p class="gallery-note">潮風、斜面の日差し、木々の間を抜ける風。花が咲き、実が育ち、人が集まる。畑には、訪れるたびに違う景色があります。</p>
      <div class="farm-gallery__grid">
        {farmScenes.map((scene, index) => (
          <figure class:list={["gallery-scene", { "gallery-scene--wide": index === 0 }]}>
            <img src={scene.image.src} alt={scene.alt} loading="eager" decoding="async" />
            <figcaption>{scene.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="farm-product" aria-labelledby="product-title">
      <header class="farm-product__heading">
        <p class="farm-product__label">WEEKEND LEMON</p>
        <h2 id="product-title">週末移住レモン果汁</h2>
        <p class="farm-product__lead">島との関係が始まる、小さな一本。</p>
      </header>
      <figure>
        <img src={weekendLemonJuice.src} alt="週末移住レモン果汁の瓶と古民家の風景" loading="eager" />
      </figure>
      <div class="farm-product__copy">
        <h3>中島のレモンを、日常の一杯に。</h3>
        <p>愛媛・中島のレモンから生まれた、100％レモン果汁です。炭酸割り、料理、お酒、お風呂上がりの一杯に。日常の中で、島の果実を気軽に楽しんでいただけます。</p>
        <dl>
          <div><dt>内容量</dt><dd>150ml</dd></div>
          <div><dt>原材料名</dt><dd>レモン</dd></div>
          <div><dt>価格</dt><dd>800円</dd></div>
          <div><dt>保存方法</dt><dd>直射日光を避け、常温で保存</dd></div>
        </dl>
        <p class="farm-product__note">開栓後は10℃以下で保存し、早めに使用してください。商品の売上は、レモン畑の手入れや次の季節の活動につながります。</p>
        <a href={weekendLemonJuiceUrl} target="_blank" rel="noreferrer">週末移住レモン果汁を見る <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="fresh-lemon" aria-labelledby="fresh-lemon-title">
      <figure><img src={lemonBasket.src} alt="中島の畑で収穫したレモン" loading="eager" /></figure>
      <div>
        <p class="eyebrow">FRESH LEMON</p>
        <h2 id="fresh-lemon-title">旬の中島レモンも、<br />季節に合わせて届けます。</h2>
        <p>中島の畑で収穫したレモンを、1kg単位で販売します。形や大きさはひとつずつ異なりますが、それも島の畑で育ったレモンの個性です。</p>
        <h3>中島レモン 1kg</h3>
        {freshLemon.status === "available" && freshLemon.url ? (
          <a href={freshLemon.url}>中島レモンを見る <span aria-hidden="true">→</span></a>
        ) : (
          <span class="fresh-lemon__status">販売準備中</span>
        )}
      </div>
    </section>

  </article>
  <script>
    const farmStage = document.querySelector<HTMLElement>(".farm-stage");
    const farmArt = farmStage?.querySelector<HTMLImageElement>("[data-farm-hero-art]");

    if (farmStage && farmArt) {
      farmStage.classList.add("is-art-loading");

      const imageLoaded = new Promise<void>((resolve) => {
        if (farmArt.complete) {
          resolve();
          return;
        }
        farmArt.addEventListener("load", () => resolve(), { once: true });
        farmArt.addEventListener("error", () => resolve(), { once: true });
      });

      const artReady = imageLoaded.then(async () => {
        if (typeof farmArt.decode === "function") {
          await farmArt.decode().catch(() => undefined);
        }
      });

      const maximumWait = new Promise<void>((resolve) => {
        window.setTimeout(resolve, 1800);
      });

      Promise.race([artReady, maximumWait]).then(() => {
        window.requestAnimationFrame(() => {
          farmStage.classList.remove("is-art-loading");
          farmStage.classList.add("is-art-ready");
        });
      });
    }
  </script>
</BaseLayout>

<style>
  :global(body) { background: #36a9ee; }
  :global(body:has(.farm-page)) { --site-frame-space: clamp(8px, .7vw, 10px); }
  :global(body:has(.farm-page) .site-header) { display: none; }
  .farm-page { position: relative; overflow: clip; background: #36a9ee; color: #fff; }
  .word-keep { white-space: nowrap; }
  .eyebrow { margin: 0 0 1rem; color: #ffe000; font-size: .78rem; font-weight: 800; line-height: 1.4; letter-spacing: .16em; }
  .farm-hero h1, .farm-intro h2, .farm-gallery h2, .farm-product h2 { margin: 0; color: #fff; font-family: "Noto Serif JP", serif; font-weight: 500; letter-spacing: .01em; text-wrap: balance; }
  .farm-intro { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(3rem, 6vw, 6rem); width: min(calc(100% - 5rem), 1120px); margin: 0 auto; padding: clamp(5rem, 6.5vw, 6rem) 0; border-top: 1px solid rgb(255 255 255 / 48%); }
  .farm-intro h2, .farm-gallery h2, .farm-product h2 { max-width: 18em; font-size: clamp(2.125rem, 2.5vw, 2.25rem); line-height: 1.45; }
  .farm-intro > p { align-self: end; margin: 0; font-size: 1rem; font-weight: 500; line-height: 1.9; }
  .farm-process { display: grid; gap: clamp(2rem, 3vw, 2.5rem); width: min(calc(100% - 5rem), 1180px); margin: 0 auto; padding-bottom: clamp(5rem, 6.5vw, 6rem); }
  .process-card { display: grid; grid-template-columns: 45% 55%; min-height: 0; overflow: hidden; border: 2px solid #143d62; border-radius: 1.2rem; background: #fffaf0; color: #143d62; box-shadow: .5rem .55rem 0 #ffe000; }
  .process-card:nth-child(even) figure { order: 2; }
  .process-card figure { display: grid; place-items: center; margin: 0; overflow: hidden; background: #f4efe5; }
  .process-card figure img { display: block; width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .5s ease; }
  .process-card__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 3.5vw, 3rem); }
  .process-card__copy > span { color: #e2b900; font-size: .82rem; font-weight: 900; letter-spacing: .18em; }
  .process-card h2 { margin: 1rem 0 1.25rem; font-family: "Noto Sans JP", sans-serif; font-size: clamp(1.375rem, 1.65vw, 1.5rem); font-weight: 500; line-height: 1.5; }
  .process-card p { max-width: 30rem; margin: 0; font-size: 1rem; font-weight: 500; line-height: 1.9; }
  .farm-gallery {
    width: min(calc(100% - 5rem), 1180px);
    margin: 0 auto;
    padding-block: clamp(5rem, 6.5vw, 6rem);
  }
  .farm-gallery__heading { margin-bottom: 1rem; }
  .gallery-note { max-width: 42rem; margin: 1.25rem 0 clamp(2.5rem, 4vw, 3rem); font-size: 1rem; line-height: 1.9; }
  .farm-gallery__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.2rem, 2vw, 1.75rem); align-items: start; }
  .gallery-scene { margin: 0; padding: .55rem .55rem 1rem; background: #fffaf0; color: #143d62; box-shadow: .4rem .45rem 0 #ffe000; }
  .gallery-scene:nth-child(even) { transform: rotate(.55deg); }
  .gallery-scene:nth-child(odd) { transform: rotate(-.45deg); }
  .gallery-scene--wide { grid-column: span 2; grid-row: span 2; }
  .gallery-scene img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .gallery-scene figcaption { padding: .8rem .35rem 0; font-size: .8125rem; font-weight: 700; line-height: 1.65; }
  .farm-product { display: grid; grid-template-columns: 1fr .8fr; align-items: center; width: min(calc(100% - 5rem), 1120px); margin: 0 auto clamp(5rem, 6.5vw, 6rem); padding: clamp(3rem, 4vw, 4rem); border: 2px solid #143d62; border-radius: 1.2rem; background: #fffaf0; color: #143d62; box-shadow: .65rem .7rem 0 #ffe000; }
  .farm-product .eyebrow { color: #c7a300; }
  .farm-product h2 { color: #143d62; }
  .farm-product__copy > p:last-of-type { max-width: 32rem; margin: 1.5rem 0 2rem; font-size: .96rem; line-height: 2; }
  .farm-product a { box-sizing: border-box; display: inline-flex; gap: 2rem; align-items: center; min-height: 52px; padding: .65rem 1.2rem; border: 2px solid #143d62; border-radius: .55rem; background: #ffe000; color: #143d62; font-size: .9rem; font-weight: 800; text-decoration: none; }
  .farm-product figure { display: flex; justify-content: center; margin: 0; }
  .farm-product img { display: block; width: min(100%, 21rem); max-height: 30rem; object-fit: contain; }
  @media (hover: hover) { .process-card:hover figure img { transform: scale(1.025); } .farm-product a:hover { background: #143d62; color: #fff; } }
  @media (max-width: 767px) {
    :global(body:has(.farm-page)) { --site-frame-space: 5px; }
    .eyebrow { font-size: .72rem; }
    .farm-intro { grid-template-columns: 1fr; gap: 2rem; width: calc(100% - 40px); padding: 4rem 0; }
    .farm-intro h2, .farm-gallery h2, .farm-product h2 { font-size: 1.75rem; line-height: 1.5; }
    .farm-intro > p { font-size: .95rem; }
    .farm-process { width: calc(100% - 40px); gap: 2rem; padding-bottom: 4rem; }
    .process-card { grid-template-columns: 1fr; min-height: 0; box-shadow: .35rem .4rem 0 #ffe000; }
    .process-card:nth-child(even) figure { order: 0; }
    .process-card figure { aspect-ratio: 4 / 3; }
    .process-card__copy { padding: 1.75rem 1.4rem 2rem; }
    .process-card h2 { font-size: 1.3125rem; }
    .process-card p { font-size: .95rem; }
    .farm-gallery {
      width: calc(100% - 40px);
      padding-block: 4rem;
    }
    .farm-gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1rem; }
    .gallery-scene, .gallery-scene--wide { grid-column: span 1; grid-row: auto; }
    .gallery-scene--wide, .gallery-scene:last-child { grid-column: 1 / -1; }
    .gallery-note { margin: 1rem 0 2.5rem; font-size: .95rem; }
    .farm-product { grid-template-columns: 1fr; width: calc(100% - 40px); margin-bottom: 4rem; padding: 2rem 1.4rem; box-shadow: .4rem .45rem 0 #ffe000; }
    .farm-product figure { margin-top: 2rem; }
    .farm-product a { justify-content: space-between; width: 100%; min-height: 52px; }
  }
  @media (prefers-reduced-motion: reduce) { .process-card figure img { transition: none; } }

  /* Lemon farm hero with soft island light. */
  .farm-page {
    border-top: 4px solid #ffe000;
  }

  .farm-hero {
    position: relative;
    display: grid;
    align-items: center;
    box-sizing: border-box;
    isolation: isolate;
    grid-template-columns: minmax(23rem, 0.88fr) minmax(0, 1.12fr);
    min-height: clamp(38rem, 78svh, 44rem);
    padding: clamp(6.5rem, 9vh, 7.5rem) clamp(3rem, 5vw, 5.5rem) clamp(4rem, 6vh, 5rem) clamp(5rem, 8vw, 8rem);
    gap: clamp(1rem, 2vw, 2.5rem);
    overflow: hidden;
  }

  .farm-hero::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(
        ellipse 72% 88% at 94% 13%,
        rgb(255 235 145 / 22%) 0%,
        rgb(255 235 145 / 11%) 34%,
        rgb(255 235 145 / 4%) 52%,
        transparent 71%
      );
    content: "";
    opacity: 0.92;
    pointer-events: none;
    transition: opacity 360ms ease;
  }

  .farm-hero__copy {
    position: relative;
    z-index: 8;
    align-self: center;
    transform: translateY(-1.75rem);
  }

  .farm-hero h1 {
    max-width: 11em;
    font-size: clamp(2.55rem, 3.35vw, 3.1rem);
    line-height: 1.5;
    letter-spacing: 0.045em;
  }

  .farm-hero__lead {
    max-width: 32rem;
    margin-top: 2rem;
    font-size: clamp(0.95rem, 1.05vw, 1.05rem);
    line-height: 1.95;
    text-wrap: pretty;
  }

  .farm-hero__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    min-height: 48px;
    margin-top: 2.4rem;
    color: #fff;
    font-size: 0.96rem;
    font-weight: 800;
    text-decoration: none;
  }

  .farm-hero__cta::after {
    position: absolute;
    right: 0;
    bottom: 0.2rem;
    left: 0;
    height: 3px;
    background: #ffe000;
    content: "";
    transform-origin: left center;
    transition: right 300ms ease, transform 300ms ease;
  }

  .farm-hero__cta span {
    transition: transform 300ms ease;
  }

  .farm-stage {
    position: relative;
    z-index: 2;
    align-self: center;
    justify-self: end;
    width: min(45vw, 46rem);
    max-width: 100%;
    min-height: 0;
    aspect-ratio: 3 / 2;
    isolation: isolate;
    transform: translateY(-2.25rem);
    transition: opacity 720ms ease;
  }

  .farm-stage.is-art-loading {
    opacity: 0;
    transition: none;
  }

  .farm-stage__ground-light {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    width: 96%;
    height: 23%;
    background:
      radial-gradient(ellipse 48% 63% at 30% 59%, rgb(255 231 125 / 16%) 0%, rgb(255 231 125 / 8%) 46%, transparent 76%),
      radial-gradient(ellipse 58% 72% at 72% 48%, rgb(255 239 174 / 15%) 0%, rgb(255 231 125 / 7%) 45%, transparent 78%);
    filter: blur(26px);
    transform: rotate(-2deg);
    pointer-events: none;
  }

  .farm-stage__shadow {
    position: absolute;
    z-index: 2;
    filter: blur(3px);
    opacity: 0.18;
    pointer-events: none;
  }

  .farm-stage__shadow--person {
    left: 0;
    bottom: 0;
    width: 32%;
    height: 12%;
