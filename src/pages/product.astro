---
import BaseLayout from "@/layouts/BaseLayout.astro";

import lemonCooking from "@/assets/images/product/lp/lemon-cooking.webp";
import lemonCookingSm from "@/assets/images/product/lp/lemon-cooking-sm.webp";
import lemonCookingJpg from "@/assets/images/product/lp/lemon-cooking.jpg";
import lemonFarmWide from "@/assets/images/product/lp/lemon-farm-wide.webp";
import lemonFarmWideSm from "@/assets/images/product/lp/lemon-farm-wide-sm.webp";
import lemonFarmWideJpg from "@/assets/images/product/lp/lemon-farm-wide.jpg";
import lemonFarmMobile from "@/assets/images/product/lp/lemon-farm-mobile.webp";
import lemonFarmMobileSm from "@/assets/images/product/lp/lemon-farm-mobile-sm.webp";
import lemonFarmMobileJpg from "@/assets/images/product/lp/lemon-farm-mobile.jpg";
import harvestHand from "@/assets/images/product/lp/lemon-harvest-hand.webp";
import harvestHandSm from "@/assets/images/product/lp/lemon-harvest-hand-sm.webp";
import harvestHandJpg from "@/assets/images/product/lp/lemon-harvest-hand.jpg";
import harvestBasket from "@/assets/images/product/lp/lemon-harvest-basket.webp";
import harvestBasketSm from "@/assets/images/product/lp/lemon-harvest-basket-sm.webp";
import harvestBasketJpg from "@/assets/images/product/lp/lemon-harvest-basket.jpg";
import eventLabels from "@/assets/images/product/lp/event-labels.webp";
import eventLabelsSm from "@/assets/images/product/lp/event-labels-sm.webp";
import eventLabelsJpg from "@/assets/images/product/lp/event-labels.jpg";
import productBottleCutout from "@/assets/images/product/lp/product-bottle-cutout.webp";
import productBottleCutoutPng from "@/assets/images/product/lp/product-bottle-cutout.png";
import lemonSquash from "@/assets/images/product/lp/lemon-squash-card.webp";
import lemonSquashSm from "@/assets/images/product/lp/lemon-squash-card-sm.webp";
import lemonSquashJpg from "@/assets/images/product/lp/lemon-squash-card.jpg";

const shopUrl = "https://weekend-island-shop.square.site/";
const productUrl = "https://yano-official-site.pages.dev/product/";
const productOgImage = "https://yano-official-site.pages.dev/og/product-og.jpg";
const productStructuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "週末移住レモン果汁",
  description: "愛媛・中島で育ったレモンから生まれた100％レモン果汁",
  image:
    "https://yano-official-site.pages.dev/images/product/weekend-lemon-juice-bottle.webp",
  brand: { "@type": "Brand", name: "週末移住レモン" },
  offers: {
    "@type": "Offer",
    price: "800",
    priceCurrency: "JPY",
    url: shopUrl,
  },
};

const features = [
  [
    "01",
    "瀬戸内・中島のレモン",
    "島の斜面にある畑で育ったレモンを使用しています。",
  ],
  ["02", "果汁100％", "香料や甘味料を加えず、レモンそのものの風味を届けます。"],
  [
    "03",
    "飲み物にも、料理にも",
    "甘くないから、炭酸やお酒、日々の料理に幅広く使えます。",
  ],
];

const productDetails = [
  ["商品名", "週末移住レモン果汁"],
  ["内容量", "150ml"],
  ["価格", "800円（税込）"],
  ["原材料名", "レモン"],
  ["保存方法", "直射日光を避け、常温で保存してください。"],
  ["開栓後", "10℃以下で保存し、お早めにお召し上がりください。"],
  ["販売者", "矢野諭稔（しとらすすたんどKominKa）"],
];

const heroBottles = Array.from({ length: 10 }, (_, index) => index + 1);
---

<BaseLayout
  title="週末移住レモン果汁"
  description="愛媛・中島で育ったレモンから生まれた100％レモン果汁。味わい、楽しみ方、畑の物語をご紹介します。"
  canonical={productUrl}
  ogImage={productOgImage}
  preloadImages={[productBottleCutout.src]}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(productStructuredData)}
  />
  <article class="product-lp">
    <section class="product-hero" aria-labelledby="product-title">
      <div class="product-hero__pattern" aria-hidden="true">
        {
          heroBottles.map((number) => (
            <picture class={`hero-bottle hero-bottle--${number}`}>
              <source srcset={productBottleCutout.src} type="image/webp" />
              <img
                src={productBottleCutoutPng.src}
                alt=""
                width="920"
                height="1600"
                loading="eager"
                decoding="async"
              />
            </picture>
          ))
        }
      </div>
      <div class="product-hero__copy">
        <p class="eyebrow">WEEKEND ISLAND PRODUCT</p>
        <h1 id="product-title"><span>週末移住</span><span>レモン果汁</span></h1>
        <p class="product-hero__catch">中島のレモンを、ぎゅっと一本に。</p>
        <p class="product-price">
          <span>150ml</span><strong>800円</strong><small>（税込）</small>
        </p>
        <a
          class="buy-button"
          href={shopUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>オンラインで購入する</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="product-intro" aria-labelledby="product-intro-title">
      <div class="product-intro__inner">
        <p class="eyebrow">FROM NAKAJIMA, EHIME</p>
        <h2 id="product-intro-title">島の果実を、<br />日常の中へ。</h2>
        <p>
          愛媛・中島で育ったレモンから生まれた、100％レモン果汁です。炭酸やお酒に加えたり、料理の仕上げに使ったり。島の果実を、日常の中で気軽に楽しめます。
        </p>
      </div>
    </section>

    <section class="features" aria-labelledby="features-title">
      <header class="section-heading section-heading--center">
        <p class="eyebrow">THREE THINGS</p>
        <h2 id="features-title">レモンのおいしさを、<br />そのまま。</h2>
      </header>
      <div class="features__stage">
        <picture class="features__farm">
          <source
            srcset={`${lemonFarmWideSm.src} 960w, ${lemonFarmWide.src} 1600w`}
            sizes="(max-width: 767px) 90vw, 55vw"
            type="image/webp"
          />
          <img
            src={lemonFarmWideJpg.src}
            alt="中島の畑に実るレモン"
            width="1600"
            height="900"
            loading="lazy"
            decoding="async"
            sizes="(max-width: 767px) 90vw, 55vw"
          />
        </picture>
        <picture class="features__bottle">
          <source srcset={productBottleCutout.src} type="image/webp" />
          <img
            src={productBottleCutoutPng.src}
            alt="週末移住レモン果汁"
            width="920"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <ol class="features__list">
          {
            features.map(([number, title, body]) => (
              <li>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="taste" aria-labelledby="taste-title">
      <div class="taste__copy">
        <p class="eyebrow">TASTE</p>
        <h2 id="taste-title">島の酸っぱさを、<br />日常に。</h2>
        <p>
          ひと口目は、きゅっと鮮やかな酸味。<br />
          そのあとに、レモンらしい香りと、ほのかな苦みが残ります。<br />
          甘くないから、飲み物にも料理にも使える一本です。
        </p>
      </div>
      <div class="taste__notes" aria-label="味わいの特徴">
        <div>
          <span class="taste-lemon" aria-hidden="true"></span><strong
            >酸味</strong
          ><small>きゅっと鮮やか</small>
        </div>
        <div>
          <span class="taste-lemon taste-lemon--leaf" aria-hidden="true"
          ></span><strong>香り</strong><small>レモンらしく爽やか</small>
        </div>
        <div>
          <span class="taste-lemon taste-lemon--half" aria-hidden="true"
          ></span><strong>ほのかな苦み</strong><small>あと味に、少しだけ</small>
        </div>
      </div>
    </section>

    <section class="enjoy" aria-labelledby="enjoy-title">
      <header class="section-heading">
        <p class="eyebrow">HOW TO ENJOY</p>
        <h2 id="enjoy-title">こんなふうに、<br />楽しめます。</h2>
      </header>
      <div class="enjoy__grid">
        <article class="enjoy-card">
          <picture>
            <source
              srcset={`${lemonSquashSm.src} 720w, ${lemonSquash.src} 1400w`}
              sizes="(max-width: 767px) 90vw, 33vw"
              type="image/webp"
            />
            <img
              src={lemonSquashJpg.src}
              alt="炭酸の泡が立つレモンスカッシュと週末移住レモン果汁"
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 767px) 90vw, 33vw"
            />
          </picture>
          <div>
            <p class="enjoy-card__number">01</p><h3>レモンスカッシュ</h3><p>
              炭酸水で割って、島のレモンスカッシュに。
            </p>
          </div>
        </article>
        <article class="enjoy-card enjoy-card--illustration enjoy-card--pink">
          <div class="drink-drawing drink-drawing--short" aria-hidden="true">
            <span></span><i></i>
          </div>
          <div>
            <p class="enjoy-card__number">02</p><h3>レモンサワー</h3><p>
              焼酎やジンに加えて、すっきりと。
            </p>
          </div>
        </article>
        <article class="enjoy-card">
          <picture>
            <source
              srcset={`${lemonCookingSm.src} 720w, ${lemonCooking.src} 1400w`}
              sizes="(max-width: 767px) 90vw, 33vw"
              type="image/webp"
            />
            <img
              src={lemonCookingJpg.src}
              alt="輪切りレモンをのせた鍋料理"
              width="1400"
              height="1400"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 767px) 90vw, 33vw"
            />
          </picture>
          <div>
            <p class="enjoy-card__number">03</p><h3>いつもの料理に</h3><p>
              鍋料理やドレッシング、魚料理など、いつもの食卓にレモンの酸味を加えて。
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="farm-story" aria-labelledby="story-title">
      <picture class="farm-story__hero">
        <source
          media="(max-width: 767px)"
          srcset={`${lemonFarmMobileSm.src} 800w, ${lemonFarmMobile.src} 1200w`}
          sizes="100vw"
          type="image/webp"
        />
        <source
          media="(max-width: 767px)"
          srcset={lemonFarmMobileJpg.src}
          type="image/jpeg"
        />
        <source
          srcset={`${lemonFarmWideSm.src} 960w, ${lemonFarmWide.src} 1600w`}
          sizes="100vw"
          type="image/webp"
        />
        <img
          src={lemonFarmWideJpg.src}
          alt="中島のレモン畑"
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
          sizes="100vw"
        />
      </picture>
      <div class="farm-story__inner">
        <div class="farm-story__copy">
          <p class="eyebrow">THE FARM STORY</p>
          <h2 id="story-title">島で出会った、<br />100本のレモン畑。</h2>
          <blockquote>「もう、レモンの木は<br />全部切る」</blockquote>
          <p>
            この畑を長く手入れしてきたのは、古民家再生を始めた頃から、活動を見守ってくれていた島の農家さんです。
          </p>
          <p>
            けれど、足を痛めてから斜面での作業が難しくなり、「もうレモンの木は全部切る」と聞きました。
          </p>
          <p>
            農業は初めてでした。それでも、木がなくなることへの寂しさと、「残さないと」という衝動から、100本の手入れを引き継ぎました。
          </p>
          <p>
            週末に草を刈り、枝を見て、収穫した実の行き先まで考える。古民家とレモン畑は、物理的に隣り合う場所ではありません。けれど、どちらも島で出会った人との関係から始まった活動です。
          </p>
          <p>このレモン果汁は、島で受け取った関係の続きにあります。</p>
          <a class="text-arrow" href="/lemon-farm/"
            >100本のレモン畑を見る <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="farm-story__photos">
          <figure>
            <picture
              ><source
                srcset={`${harvestHandSm.src} 720w, ${harvestHand.src} 1200w`}
                sizes="(max-width: 767px) 90vw, 34vw"
                type="image/webp"
              /><img
                src={harvestHandJpg.src}
                alt="畑で収穫した二つのレモン"
                width="1200"
                height="1500"
                loading="lazy"
                decoding="async"
                sizes="(max-width: 767px) 90vw, 34vw"
              /></picture
            >
            <figcaption>
              見た目も形も、一つずつ違う。島の畑で実ったレモンを、自分たちの手で収穫しています。
            </figcaption>
          </figure>
          <picture class="farm-story__basket"
            ><source
              srcset={`${harvestBasketSm.src} 720w, ${harvestBasket.src} 1200w`}
              sizes="(max-width: 767px) 90vw, 34vw"
              type="image/webp"
            /><img
              src={harvestBasketJpg.src}
              alt="籠と箱に集めた収穫後のレモン"
              width="1200"
              height="1500"
              loading="lazy"
              decoding="async"
              sizes="(max-width: 767px) 90vw, 34vw"
            /></picture
          >
        </div>
      </div>
    </section>

    <section class="related" aria-labelledby="related-title">
      <div class="related__episode">
        <picture
          ><source
            srcset={`${eventLabelsSm.src} 900w, ${eventLabels.src} 1800w`}
            sizes="(max-width: 767px) 90vw, 55vw"
            type="image/webp"
          /><img
            src={eventLabelsJpg.src}
            alt="色とりどりの限定ラベルが貼られたレモン果汁"
            width="1800"
            height="1200"
            loading="lazy"
            decoding="async"
            sizes="(max-width: 767px) 90vw, 55vw"
          /></picture
        >
        <div>
          <p class="eyebrow">A SMALL CONNECTION</p><h2 id="related-title">
            レモンから生まれた、<br />小さなつながり。
          </h2><p>
            イベントでは、色とりどりの絵をラベルにした一本も生まれました。レモンを売るだけでなく、島や人との関係が増えていくことも、この活動の楽しみです。
          </p>
        </div>
      </div>
      <a class="related-card" href="/lemon-farm/"
        ><span>畑のことを、もう少し。</span><strong
          >100本のレモン畑を見る</strong
        ><i aria-hidden="true">→</i></a
      >
    </section>

    <section class="details" aria-labelledby="details-title">
      <picture class="details__image"
        ><source srcset={productBottleCutout.src} type="image/webp" /><img
          src={productBottleCutoutPng.src}
          alt="週末移住レモン果汁の商品写真"
          width="920"
          height="1600"
          loading="lazy"
          decoding="async"
        /></picture
      >
      <div class="details__copy">
        <p class="eyebrow">PRODUCT INFORMATION</p>
        <h2 id="details-title">商品情報</h2>
        <dl>
          {
            productDetails.map(([term, value]) => (
              <div>
                <>
                  <dt>{term}</dt>
                  <dd>{value}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section
      class="final-cta"
      data-final-purchase
      aria-labelledby="final-cta-title"
    >
      <picture
        ><source srcset={productBottleCutout.src} type="image/webp" /><img
          src={productBottleCutoutPng.src}
          alt="週末移住レモン果汁"
          width="920"
          height="1600"
          loading="lazy"
          decoding="async"
        /></picture
      >
      <div>
        <p class="eyebrow">FROM THE ISLAND</p>
        <h2 id="final-cta-title">島のレモンを、<br />食卓へ。</h2>
        <p>週末に通うレモン畑から、一本ずつお届けします。</p>
        <h3>週末移住レモン果汁</h3>
        <p class="product-price">
          <span>150ml</span><strong>800円</strong><small>（税込）</small>
        </p>
        <a
          class="buy-button"
          href={shopUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="週末移住レモン果汁をオンラインで購入する（新しいタブで開く）"
          ><span>オンラインで購入する</span><span aria-hidden="true">↗</span></a
        >
      </div>
    </section>
  </article>

  <aside class="sticky-buy" data-sticky-buy aria-label="商品を購入">
    <span>150ml・800円</span>
    <a href={shopUrl} target="_blank" rel="noopener noreferrer">購入する ↗</a>
  </aside>
</BaseLayout>

<script>
  const stickyBuy = document.querySelector<HTMLElement>("[data-sticky-buy]");
  const finalPurchase = document.querySelector<HTMLElement>(
    "[data-final-purchase]",
  );
  const footer = document.querySelector<HTMLElement>("footer");
  let hasScrolled = window.scrollY > 520;
  let finalPurchaseVisible = false;
  let footerVisible = false;
  let scrollFrame = 0;
  const updateStickyBuy = () => {
    if (!stickyBuy) return;
    stickyBuy.toggleAttribute(
      "data-visible",
      hasScrolled && !finalPurchaseVisible && !footerVisible,
    );
  };
  const onScroll = () => {
    if (scrollFrame) return;
    scrollFrame = window.requestAnimationFrame(() => {
      hasScrolled = window.scrollY > 520;
      scrollFrame = 0;
      updateStickyBuy();
    });
  };
  const visibilityObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.target === finalPurchase)
          finalPurchaseVisible = entry.isIntersecting;
        if (entry.target === footer) footerVisible = entry.isIntersecting;
      });
      updateStickyBuy();
    },
    { rootMargin: "0px 0px -10%" },
  );
  if (finalPurchase) visibilityObserver.observe(finalPurchase);
  if (footer) visibilityObserver.observe(footer);
  updateStickyBuy();
  window.addEventListener("scroll", onScroll, { passive: true });
</script>

<style>
  :global(body) {
    background: #36a9ee;
  }
  .product-lp {
    --blue: #36a9ee;
    --navy: #18395e;
    --cream: #fffdf4;
    --yellow: #ffe000;
    --pink: #f7b8cb;
    overflow: clip;
    color: var(--navy);
    background: var(--blue);
  }
  .product-lp *,
  .product-lp *::before,
  .product-lp *::after {
    box-sizing: border-box;
  }
  .eyebrow {
    margin: 0 0 1rem;
    color: #2e7ca8;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }
  h1,
  h2,
  h3,
  p,
  figure,
  blockquote {
    margin-top: 0;
  }
  h1,
  h2 {
    font-family: "Noto Serif JP", serif;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  h2 {
    margin-bottom: 1.75rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.45;
  }
  .product-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(380px, 0.9fr) minmax(470px, 1.1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
    min-height: calc(100svh - 76px);
    padding: clamp(5rem, 8vw, 8rem) max(5vw, calc((100vw - 1180px) / 2));
  }
  .product-hero__yano {
    position: absolute;
    z-index: 2;
    top: 2rem;
    left: max(1rem, calc((100vw - 1360px) / 2));
    transform: scale(1);
    transform-origin: top left;
  }
  .product-hero__yano :global(.yano-brand) {
    position: relative;
    top: 0;
    left: 0;
  }
  .product-hero__visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 660px;
  }
  .product-hero__visual::before {
    position: absolute;
    width: min(92%, 560px);
    aspect-ratio: 1;
    border-radius: 48% 52% 46% 54%;
    background: var(--yellow);
    content: "";
    transform: rotate(-8deg);
  }
  .product-hero__visual::after {
    position: absolute;
    right: 4%;
    bottom: 7%;
    width: 42%;
    aspect-ratio: 1.5;
    border-radius: 50%;
    background: var(--pink);
    content: "";
    transform: rotate(18deg);
  }
  .product-hero__visual picture {
    position: relative;
    z-index: 1;
    display: block;
    width: min(72%, 370px);
    filter: drop-shadow(16px 20px 12px rgb(24 57 94 / 28%));
  }
  .product-hero__visual img {
    display: block;
    width: 100%;
    height: auto;
  }
  .lemon-slice {
    position: absolute;
    width: 112px;
    aspect-ratio: 1;
    border: 13px solid var(--yellow);
    border-radius: 50%;
    opacity: 0.85;
  }
  .lemon-slice::before {
    position: absolute;
    inset: 13px;
    border: 2px dashed var(--navy);
    border-radius: inherit;
    content: "";
    opacity: 0.45;
  }
  .lemon-slice--one {
    top: 12%;
    left: 2%;
    transform: rotate(-12deg);
  }
  .lemon-slice--two {
    right: 0;
    bottom: 11%;
    width: 80px;
    transform: rotate(18deg);
  }
  .product-hero__copy {
    max-width: 570px;
  }
  .product-hero__copy .eyebrow {
    color: var(--yellow);
  }
  .product-hero h1 {
    margin-bottom: 1.2rem;
    color: #fff;
    font-size: clamp(3rem, 5vw, 5rem);
    line-height: 1.3;
  }
  .product-hero h1 span {
    display: block;
  }
  .product-hero__catch {
    margin-bottom: 0.35rem;
    color: var(--yellow);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 800;
  }
  .product-hero__sub {
    margin-bottom: 1.4rem;
    color: #fff;
    font-size: 1.05rem;
  }
  .product-price {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    color: var(--navy);
  }
  .product-hero .product-price {
    color: #fff;
  }
  .product-price span {
    font-size: 1rem;
    font-weight: 700;
  }
  .product-price strong {
    font-size: 1.75rem;
  }
  .product-price small {
    font-size: 0.8rem;
  }
  .product-hero__description {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: #fff;
    font-size: 0.98rem;
    font-weight: 500;
    line-height: 1.95;
  }
  .buy-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: min(100%, 350px);
    min-height: 60px;
    padding: 0.85rem 1.5rem;
    border: 2px solid #111;
    border-radius: 0.4rem;
    background: var(--yellow);
    color: var(--navy);
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0.38rem 0.42rem 0 #111;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .buy-button:hover {
    box-shadow: 0.55rem 0.6rem 0 #111;
    transform: translateY(-3px);
  }
  .buy-button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 5px;
  }
  .features,
  .enjoy,
  .details,
  .related {
    padding: clamp(5rem, 10vw, 9rem) max(5vw, calc((100vw - 1180px) / 2));
  }
  .features {
    background: var(--cream);
  }
  .section-heading {
    max-width: 760px;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .section-heading--center {
    margin-inline: auto;
    text-align: center;
  }
  .features__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 0.85fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .features__farm {
    position: absolute;
    inset: 10% 34% 8% 0;
    display: block;
    overflow: hidden;
    border: 2px solid var(--navy);
    transform: rotate(-1.2deg);
  }
  .features__farm img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .features__bottle {
    position: relative;
    z-index: 1;
    display: block;
    width: min(54%, 290px);
    margin-inline: auto;
    filter: drop-shadow(12px 18px 10px rgb(24 57 94 / 26%));
    transform: rotate(-1.5deg);
  }
  .features__bottle img {
    display: block;
    width: 100%;
  }
  .features__list {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features__list li {
    position: relative;
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    padding: 1.4rem 1.5rem;
    border: 2px solid var(--navy);
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0.28rem 0.32rem 0 rgb(24 57 94 / 16%);
  }
  .features__list li::before {
    position: absolute;
    top: 50%;
    left: -0.65rem;
    width: 1.1rem;
    height: 1.1rem;
    border-bottom: 2px solid var(--navy);
    border-left: 2px solid var(--navy);
    background: inherit;
    content: "";
    transform: translateY(-50%) rotate(45deg);
  }
  .features__list li:nth-child(2) {
    margin-left: 2rem;
    background: #fff7b8;
  }
  .features__list li:nth-child(3) {
    background: #f8d1dc;
  }
  .features__list span {
    grid-row: 1 / 3;
    color: #2e7ca8;
    font-size: 1.1rem;
    font-weight: 800;
  }
  .features__list h3 {
    margin: 0 0 0.45rem;
    font-size: 1.3rem;
  }
  .features__list p {
    margin: 0;
    color: #4c5f74;
    line-height: 1.8;
  }
  .taste {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(440px, 1.1fr);
    gap: clamp(3rem, 8vw, 8rem);
    padding: clamp(5rem, 10vw, 9rem) max(5vw, calc((100vw - 1120px) / 2));
    background: var(--pink);
  }
  .taste__copy > p:last-child {
    margin: 0;
    line-height: 2;
  }
  .taste__notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: 1rem;
  }
  .taste__notes > div {
    position: relative;
    min-height: 250px;
    padding: 1.4rem 0.85rem 1rem;
    border: 2px solid var(--navy);
    border-radius: 0.85rem;
    background: var(--cream);
    text-align: center;
  }
  .taste__notes > div::after {
    position: absolute;
    right: 1.5rem;
    bottom: -0.62rem;
    width: 1rem;
    height: 1rem;
    border-right: 2px solid var(--navy);
    border-bottom: 2px solid var(--navy);
    background: var(--cream);
    content: "";
    transform: rotate(45deg);
  }
  .taste__notes strong,
  .taste__notes small {
    display: block;
  }
  .taste__notes strong {
    margin-top: 1rem;
    font-size: 1.05rem;
  }
  .taste__notes small {
    margin-top: 0.3rem;
    color: #51677e;
    line-height: 1.5;
  }
  .taste-lemon {
    position: relative;
    display: block;
    width: 100%;
    max-width: 118px;
    aspect-ratio: 1;
    margin-inline: auto;
    border: 4px solid var(--navy);
    border-radius: 50%;
    background: var(--yellow);
  }
  .taste-lemon::before,
  .taste-lemon::after {
    position: absolute;
    top: 50%;
    left: 14%;
    width: 72%;
    height: 2px;
    background: var(--navy);
    content: "";
    transform: rotate(30deg);
  }
  .taste-lemon::after {
    transform: rotate(-30deg);
  }
  .taste-lemon--leaf {
    transform: rotate(5deg) scale(0.9);
  }
  .taste-lemon--half {
    border-radius: 50% 50% 12% 50%;
    transform: rotate(18deg);
  }
  .enjoy {
    background: var(--blue);
    color: #fff;
  }
  .enjoy .eyebrow {
    color: var(--yellow);
  }
  .enjoy__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .enjoy-card {
    overflow: hidden;
    border: 2px solid var(--navy);
    background: var(--cream);
    color: var(--navy);
    box-shadow: 0.5rem 0.55rem 0 var(--yellow);
  }
  .enjoy-card picture,
  .enjoy-card > picture img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }
  .enjoy-card > div:last-child {
    min-height: 220px;
    padding: 1.6rem;
  }
  .enjoy-card__number {
    margin-bottom: 0.4rem;
    color: #2e7ca8;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
  }
  .enjoy-card h3 {
    margin-bottom: 0.7rem;
    font-size: 1.35rem;
  }
  .enjoy-card p:last-child {
    margin: 0;
    line-height: 1.8;
  }
  .enjoy-card--illustration {
    background: #f8e56b;
  }
  .enjoy-card--pink {
    background: #f5c3d2;
  }
  .drink-drawing {
    position: relative;
    display: grid;
    place-items: center;
    height: auto;
    min-height: 0 !important;
    padding: 0 !important;
    aspect-ratio: 1;
  }
  .drink-drawing span {
    width: 38%;
    height: 58%;
    border: 5px solid var(--navy);
    border-top-width: 3px;
    border-radius: 8px 8px 25px 25px;
    transform: rotate(-3deg);
  }
  .drink-drawing span::before {
    display: block;
    width: 82%;
    height: 58%;
    margin: 48% auto 0;
    border-radius: 4px 4px 18px 18px;
    background: rgb(255 255 255 / 72%);
    content: "";
  }
  .drink-drawing i {
    position: absolute;
    top: 19%;
    right: 28%;
    width: 4px;
    height: 48%;
    background: var(--navy);
    transform: rotate(13deg);
  }
  .drink-drawing--short span {
    height: 42%;
    border-radius: 6px 6px 32px 32px;
  }
  .drink-drawing--short i {
    height: 39%;
  }
  .farm-story {
    padding-bottom: clamp(5rem, 10vw, 9rem);
    background: var(--cream);
  }
  .farm-story__hero {
    display: block;
    width: 100%;
    max-height: 680px;
    overflow: hidden;
  }
  .farm-story__hero img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
  }
  .farm-story__inner {
    display: grid;
    grid-template-columns: minmax(360px, 0.85fr) minmax(480px, 1.15fr);
    gap: clamp(4rem, 8vw, 8rem);
    padding: clamp(4rem, 8vw, 7rem) max(5vw, calc((100vw - 1180px) / 2)) 0;
  }
  .farm-story__copy blockquote {
    margin: 2.5rem 0;
    color: #2e7ca8;
    font-family: "Noto Serif JP", serif;
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    font-weight: 600;
    line-height: 1.65;
  }
  .farm-story__copy > p:not(.eyebrow) {
    line-height: 2;
  }
  .text-arrow {
    display: inline-flex;
    gap: 2rem;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid currentColor;
    font-weight: 700;
    text-decoration: none;
  }
  .farm-story__photos {
    position: relative;
    min-height: 760px;
  }
  .farm-story__photos figure {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 55%;
    margin: 0;
  }
  .farm-story__photos img {
    display: block;
    width: 100%;
    border: 8px solid #fff;
    box-shadow: 0.6rem 0.65rem 0 var(--yellow);
  }
  .farm-story__photos figcaption {
    margin-top: 1.5rem;
    padding-right: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.8;
  }
  .farm-story__basket {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 57%;
    transform: rotate(2deg);
  }
  .details {
    display: grid;
    grid-template-columns: minmax(320px, 0.8fr) minmax(480px, 1.2fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    background: var(--yellow);
  }
  .details__image {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--cream);
  }
  .details__image img {
    display: block;
    width: 52%;
    filter: drop-shadow(10px 14px 8px rgb(24 57 94 / 24%));
  }
  .details__copy dl {
    margin: 0;
    border-top: 1px solid rgb(24 57 94 / 35%);
  }
  .details__copy dl > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    padding: 1rem 0;
    border-bottom: 1px solid rgb(24 57 94 / 35%);
  }
  .details__copy dt {
    font-weight: 800;
  }
  .details__copy dd {
    margin: 0;
    line-height: 1.7;
  }
  .final-cta {
    display: grid;
    grid-template-columns: minmax(340px, 0.85fr) minmax(440px, 1.15fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    padding: clamp(5rem, 10vw, 9rem) max(5vw, calc((100vw - 1100px) / 2));
    background: var(--navy);
    color: #fff;
    border-bottom: 10px solid var(--yellow);
  }
  .final-cta > picture {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: 46% 54% 52% 48%;
    background: var(--yellow);
    transform: rotate(-3deg);
  }
  .final-cta img {
    display: block;
    width: 60%;
    filter: drop-shadow(10px 16px 8px rgb(0 0 0 / 24%));
    transform: rotate(3deg);
  }
  .final-cta .eyebrow {
    color: var(--yellow);
  }
  .final-cta h3 {
    margin: 2rem 0 0.75rem;
    font-size: 1.3rem;
  }
  .final-cta .product-price {
    color: #fff;
  }
  .related {
    background: var(--cream);
  }
  .related__episode {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(380px, 0.9fr);
    gap: clamp(3rem, 7vw, 6rem);
    align-items: center;
  }
  .related__episode picture {
    display: block;
    border: 2px solid var(--navy);
    box-shadow: 0.65rem 0.7rem 0 var(--pink);
    transform: rotate(-0.5deg);
  }
  .related__episode img {
    display: block;
    width: 100%;
  }
  .related__episode p:last-child {
    margin: 0;
    line-height: 2;
  }
  .related-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 2rem;
    margin-top: clamp(4rem, 8vw, 7rem);
    padding: 2rem;
    border: 2px solid var(--navy);
    background: var(--yellow);
    color: var(--navy);
    text-decoration: none;
  }
  .related-card span {
    grid-column: 1;
    font-size: 0.85rem;
  }
  .related-card strong {
    grid-column: 1;
    font-size: 1.35rem;
  }
  .related-card i {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    font-style: normal;
    font-size: 1.5rem;
  }
  .sticky-buy {
    position: fixed;
    z-index: 40;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    left: 12px;
    display: none;
    align-items: center;
    justify-content: space-between;
    min-height: 58px;
    padding: 0.45rem 0.5rem 0.45rem 1rem;
    border: 2px solid #111;
    border-radius: 0.5rem;
    background: var(--cream, #fffdf4);
    color: #18395e;
    box-shadow: 0.28rem 0.32rem 0 #111;
    opacity: 0;
    pointer-events: none;
    transform: translateY(140%);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }
  .sticky-buy a {
    display: grid;
    place-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    border-radius: 0.3rem;
    background: #ffe000;
    font-weight: 800;
    text-decoration: none;
  }
  @media (max-width: 1024px) {
    .product-hero {
      grid-template-columns: minmax(300px, 0.85fr) minmax(400px, 1.15fr);
      gap: 2.5rem;
    }
    .product-hero__visual {
      min-height: 560px;
    }
    .product-hero h1 {
      font-size: clamp(2.8rem, 6vw, 4rem);
    }
    .features__stage,
    .taste,
    .farm-story__inner,
    .details,
    .final-cta,
    .related__episode {
      grid-template-columns: 1fr;
    }
    .features__stage {
      max-width: 720px;
      margin-inline: auto;
    }
    .features__farm {
      inset: 3% 20% 45% 0;
    }
    .features__bottle {
      margin-right: 4%;
    }
    .features__list {
      margin-top: 2rem;
    }
    .taste__notes {
      max-width: 680px;
    }
    .farm-story__photos {
      min-height: 780px;
    }
    .details__image,
    .final-cta > picture {
      width: min(100%, 520px);
      margin-inline: auto;
    }
    .related__episode picture {
      order: 2;
    }
  }
  @media (max-width: 767px) {
    .product-hero {
      display: flex;
      min-height: 0;
      flex-direction: column;
      gap: 1.75rem;
      padding: 5.5rem 20px 4.5rem;
    }
    .product-hero__yano {
      top: 0.85rem;
      left: 1rem;
      transform: scale(0.68);
    }
    .product-hero__visual {
      order: 1;
      width: 100%;
      min-height: 0;
      padding-top: 1.5rem;
    }
    .product-hero__visual picture {
      width: min(100%, 220px);
    }
    .lemon-slice--one {
      top: 9%;
      left: 2%;
      width: 72px;
      border-width: 9px;
    }
    .lemon-slice--two {
      right: 1%;
      bottom: 7%;
      width: 60px;
      border-width: 8px;
    }
    .product-hero__copy {
      order: 2;
      display: flex;
      flex-direction: column;
      width: 100%;
    }
    .product-hero__copy .buy-button {
      order: 6;
      margin-bottom: 1.75rem;
    }
    .product-hero__description {
      order: 7;
    }
    .product-hero h1 {
      margin-bottom: 1rem;
      font-size: clamp(2.55rem, 13vw, 3.45rem);
      line-height: 1.3;
    }
    .product-hero__catch {
      font-size: 1.18rem;
    }
    .product-hero__sub {
      font-size: 0.98rem;
    }
    .product-hero__description {
      font-size: 0.92rem;
      line-height: 1.9;
    }
    .buy-button {
      width: 100%;
    }
    .features,
    .enjoy,
    .details,
    .related {
      padding: 4.5rem 20px;
    }
    h2 {
      font-size: clamp(1.9rem, 9vw, 2.6rem);
    }
    .section-heading {
      margin-bottom: 2.75rem;
    }
    .features__stage {
      display: block;
    }
    .features__farm {
      position: relative;
      inset: auto;
      width: 92%;
      margin: 0 auto 1.5rem 0;
      transform: rotate(-1deg);
    }
    .features__farm img {
      aspect-ratio: 4 / 3;
    }
    .features__bottle {
      width: 68%;
      margin: -4rem 0 2rem auto;
    }
    .features__list li {
      grid-template-columns: 2.8rem 1fr;
      padding-block: 1.5rem;
    }
    .features__list h3 {
      font-size: 1.12rem;
    }
    .features__list p {
      font-size: 0.9rem;
    }
    .taste {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 4.5rem 20px;
    }
    .taste__copy > p:last-child {
      font-size: 0.92rem;
    }
    .taste__notes {
      gap: 0.55rem;
    }
    .taste__notes strong {
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .taste__notes small {
      font-size: 0.7rem;
    }
    .taste-lemon {
      border-width: 3px;
    }
    .enjoy__grid {
      display: grid;
      grid-auto-columns: 84%;
      grid-template-columns: none;
      grid-auto-flow: column;
      gap: 1rem;
      margin-inline: -20px;
      padding: 0 20px 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
    }
    .enjoy-card {
      scroll-snap-align: start;
    }
    .enjoy-card > div:last-child {
      min-height: 205px;
    }
    .farm-story__hero img {
      aspect-ratio: 4 / 5;
    }
    .farm-story__inner {
      display: block;
      padding: 4rem 20px 0;
    }
    .farm-story__copy blockquote {
      font-size: 1.85rem;
    }
    .farm-story__copy > p:not(.eyebrow) {
      font-size: 0.92rem;
      line-height: 1.95;
    }
    .farm-story__photos {
      display: grid;
      gap: 2.5rem;
      min-height: 0;
      margin-top: 3.5rem;
    }
    .farm-story__photos figure,
    .farm-story__basket {
      position: relative;
      inset: auto;
      width: 88%;
    }
    .farm-story__photos figure {
      margin: 0 auto 0 0;
    }
    .farm-story__basket {
      margin-left: auto;
      transform: rotate(1.5deg);
    }
    .farm-story__photos figcaption {
      font-size: 0.82rem;
    }
    .details {
      gap: 3rem;
    }
    .details__copy dl > div {
      grid-template-columns: 6.2rem 1fr;
      gap: 1rem;
      font-size: 0.88rem;
    }
    .final-cta {
      gap: 3rem;
      padding: 4.5rem 20px;
    }
    .final-cta h3 {
      font-size: 1.15rem;
    }
    .related__episode {
      gap: 2.5rem;
    }
    .related__episode p:last-child {
      font-size: 0.92rem;
    }
    .related-card {
      padding: 1.4rem;
    }
    .related-card strong {
      font-size: 1.05rem;
    }
    .sticky-buy {
      display: flex;
    }
    .sticky-buy[data-visible] {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }
  }

  /* Product hero renewal */
  :global(body:has(.product-lp) .site-header) {
    position: absolute !important;
    z-index: 60 !important;
    border-bottom-color: transparent !important;
    background: transparent !important;
    color: #fff !important;
    backdrop-filter: none !important;
  }

  :global(body:has(.product-lp) .site-header .site-logo),
  :global(
