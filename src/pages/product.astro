---
import BaseLayout from "@/layouts/BaseLayout.astro";

import lemonCooking from "@/assets/images/product/lp/lemon-cooking.webp";
import lemonCookingSm from "@/assets/images/product/lp/lemon-cooking-sm.webp";
import lemonFarmWide from "@/assets/images/product/lp/lemon-farm-wide.webp";
import lemonFarmWideSm from "@/assets/images/product/lp/lemon-farm-wide-sm.webp";
import lemonFarmMobile from "@/assets/images/product/lp/lemon-farm-mobile.webp";
import lemonFarmMobileSm from "@/assets/images/product/lp/lemon-farm-mobile-sm.webp";
import harvestHand from "@/assets/images/product/lp/lemon-harvest-hand.webp";
import harvestHandSm from "@/assets/images/product/lp/lemon-harvest-hand-sm.webp";
import harvestBasket from "@/assets/images/product/lp/lemon-harvest-basket.webp";
import harvestBasketSm from "@/assets/images/product/lp/lemon-harvest-basket-sm.webp";
import eventLabels from "@/assets/images/product/lp/event-labels.webp";
import eventLabelsSm from "@/assets/images/product/lp/event-labels-sm.webp";
import productBottle from "@/assets/images/product/lp/product-bottle-cutout.webp";
import productBottlePng from "@/assets/images/product/lp/product-bottle-cutout.png";
import productSquare from "@/assets/images/product/lp/product-square.webp";
import lemonSquash from "@/assets/images/product/lp/lemon-squash-card.webp";
import lemonSquashSm from "@/assets/images/product/lp/lemon-squash-card-sm.webp";
import islandFerryView from "@/assets/images/events/nakajima-bbq-2026/island-ferry-view.jpg";

const shopUrl = "https://weekend-island-shop.square.site/";
const productUrl = "https://yano-official-site.pages.dev/product/";
const productDetails = [
  ["商品名", "週末移住レモン果汁"],
  ["内容量", "150mL"],
  ["価格", "800円（税込）"],
  ["原材料名", "レモン"],
  ["保存方法", "直射日光を避け、常温で保存してください。"],
  ["開栓後", "10℃以下で保存し、お早めにお召し上がりください。"],
  ["販売者", "矢野諭稔（しとらすすたんどKominKa）"],
];
const heroBottles = Array.from({ length: 10 }, (_, index) => index + 1);
const qualityPoints = [
  {
    number: "01",
    title: "中島で育ったレモン",
    body: "瀬戸内海に浮かぶ中島で育ったレモンを使用しています。",
    image: lemonFarmMobile,
    imageSm: lemonFarmMobileSm,
    alt: "中島の斜面に広がるレモン畑",
  },
  {
    number: "02",
    title: "収穫したレモンを果汁に",
    body: "畑で収穫したレモンを、日々の食卓で使いやすい一本の果汁にしています。",
    image: harvestBasket,
    imageSm: harvestBasketSm,
    alt: "籠と箱に集めた収穫後のレモン",
  },
  {
    number: "03",
    title: "小さく使い切れる150mL",
    body: "冷蔵庫にも収まりやすく、料理や飲み物に使いやすい150mLです。",
    image: eventLabels,
    imageSm: eventLabelsSm,
    alt: "食卓に並ぶ週末移住レモン果汁の小瓶",
  },
];
const uses = [
  {
    number: "01",
    title: "炭酸水にひと搾り",
    body: "きりっとした酸味を、泡と一緒に。すっきりとした一杯になります。",
    image: lemonSquash,
    imageSm: lemonSquashSm,
    alt: "レモン果汁を使った炭酸ドリンク",
  },
  {
    number: "02",
    title: "唐揚げや魚料理に",
    body: "食べる直前にひと回し。香りと酸味が、いつもの料理を軽やかにします。",
    image: lemonCooking,
    imageSm: lemonCookingSm,
    alt: "レモンを添えた料理",
  },
  {
    number: "03",
    title: "はちみつレモンやドレッシングに",
    body: "甘さやオイルと合わせて、好みの味へ。台所で自由に楽しめます。",
    image: harvestHand,
    imageSm: harvestHandSm,
    alt: "手のひらにのせた中島のレモン",
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "週末移住レモン果汁",
  description: "愛媛・中島で育ったレモンから生まれたレモン果汁",
  image:
    "https://yano-official-site.pages.dev/images/product/weekend-lemon-juice-bottle.webp",
  brand: { "@type": "Brand", name: "週末移住レモン" },
  offers: {
    "@type": "Offer",
    price: "800",
    priceCurrency: "JPY",
    url: shopUrl,
  },
};
---

<BaseLayout
  title="週末移住レモン果汁"
  description="愛媛・中島で育ったレモンから生まれたレモン果汁。味わい、楽しみ方、畑の物語をご紹介します。"
  canonical={productUrl}
  preloadImages={[productBottle.src]}
>
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(structuredData)}
  />

  <article class="product-lp">
    <section class="product-hero" aria-labelledby="product-title">
      <div class="hero-pattern" aria-hidden="true">
        {
          heroBottles.map((number) => (
            <picture class={`hero-bottle hero-bottle--${number}`}>
              <source srcset={productBottle.src} type="image/webp" />
              <img
                src={productBottlePng.src}
                alt=""
                width="920"
                height="1600"
                loading="eager"
                decoding="async"
              />
            </picture>
          ))
        }
      </div>
      <div class="hero-copy">
        <p class="eyebrow">WEEKEND ISLAND PRODUCT</p>
        <h1 id="product-title"><span>週末移住</span><span>レモン果汁</span></h1>
        <p class="hero-catch">中島のレモンを、ぎゅっと一本に。</p>
        <p class="price">
          <span>150mL</span><strong>800円</strong><small>（税込）</small>
        </p>
        <a
          class="buy-button"
          href={shopUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>オンラインで購入する</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="intro section-card reveal" aria-labelledby="intro-title">
      <div class="intro-copy">
        <p class="eyebrow">FROM NAKAJIMA</p>
        <h2 id="intro-title">平日は街で働いて、<br />週末は船に乗る。</h2>
        <p>中島で出会ったレモンを、<br />いつでも味わえる一本にしました。</p>
      </div>
      <div class="bottle-stage" aria-label="週末移住レモン果汁の商品ボトル">
        <span class="stage-circle" aria-hidden="true"></span>
        <span class="lemon-orb lemon-orb--left" aria-hidden="true"></span>
        <span class="lemon-orb lemon-orb--right" aria-hidden="true"></span>
        <picture>
          <source srcset={productBottle.src} type="image/webp" />
          <img
            src={productBottlePng.src}
            alt="週末移住レモン果汁のボトル"
            width="920"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </section>

    <section class="story section-card reveal" aria-labelledby="story-title">
      <picture class="story-image">
        <img
          src={islandFerryView.src}
          alt="船上から眺める瀬戸内海と中島の風景"
          width={islandFerryView.width}
          height={islandFerryView.height}
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="story-copy">
        <header class="section-title">
          <p class="eyebrow">STORY</p>
          <h2 id="story-title">一本になるまで</h2>
        </header>
        <p>平日は街で働き、週末は船で中島へ。</p>
        <p>
          草を刈り、枝を整え、<br />島の人に教わりながら、<br
          />レモン畑と少しずつ関わってきました。
        </p>
        <p>
          すべてを完璧にはできなくても、<br />できる範囲で、できるだけ丁寧に。
        </p>
        <p>その週末の積み重ねが、<br />小さな一本のレモン果汁になりました。</p>
      </div>
    </section>

    <section class="visual section-card reveal" aria-labelledby="visual-title">
      <div class="visual-copy">
        <p class="eyebrow">TASTE OF THE ISLAND</p>
        <h2 id="visual-title">ひと口で、<br />島の酸っぱさ。</h2>
        <p>香りも、苦みも、レモンのまま。<br />水や炭酸、お料理にも。</p>
      </div>
      <div class="visual-stage">
        <span class="stage-circle" aria-hidden="true"></span>
        <span class="lemon-orb lemon-orb--left" aria-hidden="true"></span>
        <span class="lemon-orb lemon-orb--right" aria-hidden="true"></span>
        <picture>
          <source srcset={productBottle.src} type="image/webp" />
          <img
            src={productBottlePng.src}
            alt="週末移住レモン果汁の商品ボトル"
            width="920"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    </section>

    <section
      class="quality section-card reveal"
      aria-labelledby="quality-title"
    >
      <header class="section-title section-title--center">
        <p class="eyebrow">QUALITY</p>
        <h2 id="quality-title">この一本のこと</h2>
      </header>
      <div class="quality-list">
        {
          qualityPoints.map((point, index) => (
            <article
              class:list={[
                "quality-item",
                { "quality-item--reverse": index % 2 === 1 },
              ]}
            >
              <picture>
                <source
                  srcset={`${point.imageSm.src} ${point.imageSm.width}w, ${point.image.src} ${point.image.width}w`}
                  sizes="(max-width: 767px) calc(100vw - 64px), 50vw"
                  type="image/webp"
                />
                <img
                  src={point.image.src}
                  alt={point.alt}
                  width={point.image.width}
                  height={point.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div class="quality-copy">
                <p class="point-number">POINT {point.number}</p>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="uses section-card reveal" aria-labelledby="uses-title">
      <header class="section-title section-title--center">
        <p class="eyebrow">HOW TO USE</p>
        <h2 id="uses-title">楽しみ方</h2>
      </header>
      <div class="use-grid">
        {
          uses.map((item) => (
            <article class="use-card">
              <picture>
                <source
                  srcset={`${item.imageSm.src} ${item.imageSm.width}w, ${item.image.src} ${item.image.width}w`}
                  sizes="(max-width: 767px) calc(100vw - 64px), (max-width: 1023px) 45vw, 360px"
                  type="image/webp"
                />
                <img
                  src={item.image.src}
                  alt={item.alt}
                  width={item.image.width}
                  height={item.image.height}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <div>
                <>
                  <span>{item.number}</span>
                  <h3>{item.title}</h3>
                  <p>{item.body}</p>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="information section-card reveal"
      aria-labelledby="information-title"
    >
      <div class="information-image">
        <span aria-hidden="true"></span>
        <img
          src={productSquare.src}
          alt="週末移住レモン果汁の商品写真"
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="information-copy">
        <header class="section-title">
          <p class="eyebrow">PRODUCT</p>
          <h2 id="information-title">商品について</h2>
        </header>
        <h3>週末移住レモン果汁</h3>
        <p class="price">
          <span>150mL</span><strong>800円</strong><small>（税込）</small>
        </p>
        <details>
          <summary>原材料・保存方法などを見る</summary>
          <dl>
            {
              productDetails.map(([term, value]) => (
                <div>
                  <>
                    <dt>{term}</dt>
                    <dd>{value}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </details>
        <a
          class="buy-button"
          href={shopUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="週末移住レモン果汁をオンラインで購入する（新しいタブで開く）"
        >
          <span>オンラインで購入する</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section
      class="final-cta section-card reveal"
      data-final-purchase
      aria-labelledby="final-title"
    >
      <picture class="final-photo">
        <source
          srcset={`${lemonFarmWideSm.src} 960w, ${lemonFarmWide.src} 1600w`}
          sizes="100vw"
          type="image/webp"
        />
        <img
          src={lemonFarmWide.src}
          alt="中島のレモン畑"
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="final-shade" aria-hidden="true"></div>
      <picture class="final-bottle">
        <source srcset={productBottle.src} type="image/webp" />
        <img
          src={productBottlePng.src}
          alt="週末移住レモン果汁"
          width="920"
          height="1600"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="final-copy">
        <p class="eyebrow">FROM THE ISLAND</p>
        <h2 id="final-title">島の週末を、<br />食卓へ。</h2>
        <p>中島のレモンを、ぎゅっと一本に。</p>
        <a
          class="buy-button"
          href={shopUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>オンラインで購入する</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </article>

  <aside class="sticky-buy" data-sticky-buy aria-label="商品を購入">
    <span>150mL・800円</span>
    <a href={shopUrl} target="_blank" rel="noopener noreferrer">購入する ↗</a>
  </aside>
</BaseLayout>

<script>
  const stickyBuy = document.querySelector<HTMLElement>("[data-sticky-buy]");
  const finalPurchase = document.querySelector<HTMLElement>(
    "[data-final-purchase]",
  );
  const footer = document.querySelector<HTMLElement>("footer");
  let hasScrolled = window.scrollY > 520;
  let finalVisible = false;
  let footerVisible = false;
  const updateSticky = () =>
    stickyBuy?.toggleAttribute(
      "data-visible",
      hasScrolled && !finalVisible && !footerVisible,
    );
  window.addEventListener(
    "scroll",
    () => {
      hasScrolled = window.scrollY > 520;
      updateSticky();
    },
    { passive: true },
  );
  const visibilityObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.target === finalPurchase) finalVisible = entry.isIntersecting;
        if (entry.target === footer) footerVisible = entry.isIntersecting;
      });
      updateSticky();
    },
    { rootMargin: "0px 0px -10%" },
  );
  if (finalPurchase) visibilityObserver.observe(finalPurchase);
  if (footer) visibilityObserver.observe(footer);
</script>

<style>
  :global(html:has(.product-lp)),
  :global(body:has(.product-lp)) {
    max-width: 100%;
    overflow-x: clip;
  }

  .product-lp {
    --blue: #36a9ee;
    --yellow: #ffe000;
    --cream: #fff9e9;
    --navy: #18395e;
    --pink: #f4a8b8;
    box-sizing: border-box;
    overflow: clip;
    background: var(--cream);
    color: var(--navy);
    font-family: "Noto Sans JP", sans-serif;
  }
  .product-lp *,
  .product-lp *::before,
  .product-lp *::after {
    box-sizing: border-box;
  }
  .product-lp h1,
  .product-lp h2,
  .product-lp h3,
  .product-lp p {
    margin-top: 0;
  }
  .product-lp h1,
  .product-lp h2 {
    font-family: "Noto Serif JP", serif;
    font-weight: 500;
  }
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--navy);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.19em;
  }
  .section-card {
    width: min(calc(100% - 40px), 1200px);
    margin: 24px auto 0;
    border: 2px solid var(--navy);
    border-radius: clamp(28px, 4vw, 52px);
  }
  .section-title h2 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 1.35;
    letter-spacing: 0.04em;
  }
  .section-title--center {
    text-align: center;
  }

  .product-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 7rem 1.5rem 3rem;
    overflow: hidden;
    background-color: var(--blue);
    background-image: radial-gradient(
      circle,
      rgb(255 224 0 / 26%) 2px,
      transparent 2.4px
    );
    background-size: 42px 42px;
  }
  .hero-copy {
    position: relative;
    z-index: 4;
    display: grid;
    justify-items: center;
    width: min(100%, 42rem);
    text-align: center;
  }
  .hero-copy::before {
    position: absolute;
    z-index: -1;
    width: min(72vw, 35rem);
    aspect-ratio: 1.35;
    border: 1px solid rgb(255 255 255 / 42%);
    border-radius: 50%;
    background: rgb(255 249 233 / 12%);
    content: "";
  }
  .hero-copy .eyebrow {
    color: var(--yellow);
  }
  .hero-copy h1 {
    margin-bottom: 1rem;
    color: #fff;
    font-size: clamp(3.4rem, 7vw, 6.4rem);
    line-height: 1.13;
    letter-spacing: 0.04em;
    text-shadow: 0 2px 16px rgb(24 57 94 / 15%);
  }
  .hero-copy h1 span {
    display: block;
  }
  .hero-catch {
    margin-bottom: 1.25rem;
    color: #fff;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    font-weight: 700;
  }
  .price {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-bottom: 1.55rem;
    color: inherit;
  }
  .price span {
    font-weight: 700;
  }
  .price strong {
    font-size: 1.55rem;
  }
  .price small {
    font-size: 0.78rem;
    font-weight: 700;
  }
  .hero-copy .price {
    color: #fff;
  }
  .buy-button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-width: min(100%, 19rem);
    min-height: 58px;
    padding: 0.9rem 1.4rem;
    border: 2px solid var(--navy);
    border-radius: 999px;
    background: var(--yellow);
    box-shadow: 0 7px 0 var(--navy);
    color: var(--navy);
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }
  .buy-button:hover {
    box-shadow: 0 4px 0 var(--navy);
    transform: translateY(3px);
  }
  .buy-button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }
  .hero-pattern {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }
  .hero-bottle {
    position: absolute;
    width: clamp(7rem, 10vw, 10rem);
    transform: rotate(var(--rotate));
    animation: bottleSway 5.5s ease-in-out var(--delay) infinite alternate;
  }
  .hero-bottle img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-bottle--1 {
    top: -8%;
    left: -1%;
    --rotate: -16deg;
    --delay: -1s;
  }
  .hero-bottle--2 {
    top: 29%;
    left: 8%;
    --rotate: 14deg;
    --delay: -3s;
  }
  .hero-bottle--3 {
    top: 70%;
    left: -2%;
    --rotate: -12deg;
    --delay: -2s;
  }
  .hero-bottle--4 {
    top: -3%;
    left: 18%;
    --rotate: 18deg;
    --delay: -4s;
  }
  .hero-bottle--5 {
    top: 76%;
    left: 18%;
    --rotate: -18deg;
    --delay: -0.5s;
  }
  .hero-bottle--6 {
    top: -7%;
    right: -1%;
    --rotate: 16deg;
    --delay: -2.2s;
  }
  .hero-bottle--7 {
    top: 28%;
    right: 8%;
    --rotate: -14deg;
    --delay: -4.2s;
  }
  .hero-bottle--8 {
    top: 71%;
    right: -2%;
    --rotate: 13deg;
    --delay: -1.8s;
  }
  .hero-bottle--9 {
    top: 0;
    right: 18%;
    --rotate: -18deg;
    --delay: -3.4s;
  }
  .hero-bottle--10 {
    top: 77%;
    right: 18%;
    --rotate: 16deg;
    --delay: -0.8s;
  }

  .intro {
    position: relative;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    min-height: 46rem;
    padding: clamp(6rem, 10vw, 9rem);
    overflow: hidden;
    background: var(--yellow);
  }
  .intro-copy {
    position: relative;
    z-index: 3;
    max-width: 31rem;
  }
  .intro-copy h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(2rem, 3.3vw, 3.25rem);
    line-height: 1.55;
  }
  .intro-copy > p:last-child {
