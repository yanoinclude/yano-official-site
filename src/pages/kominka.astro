---
import BaseLayout from "@/layouts/BaseLayout.astro";
import YanoSpeechBubble from "@/components/animation/YanoSpeechBubble.astro";
import roofImage from "@/assets/images/home/kominka-roof-restoration.webp";
import interiorImage from "@/assets/images/concept-user-kominka-interior.jpeg";
import tableImage from "@/assets/images/scenery/nakajima-kominka-table.jpeg";
import clearingRoomImage from "@/assets/images/kominka/process/01-clearing-room.jpeg";
import rebuildingTogetherImage from "@/assets/images/kominka/process/02-rebuilding-together.jpeg";
import welcomingPeopleImage from "@/assets/images/kominka/process/03-welcoming-people.jpeg";

const rebuildGalleryImage = { src: "/images/kominka/gallery/rebuild-together.png" };
const welcomingGalleryImage = { src: "/images/kominka/gallery/welcoming-place.png" };
const activityBaseImage = { src: "/images/kominka/gallery/activity-base.jpeg" };

const gallery = [
  {
    image: roofImage,
    alt: "古民家の屋根に上がり、瓦を下ろしている再生作業の様子",
    caption: "屋根の上も、できるところから。",
    className: "gallery-card--wide",
  },
  {
    image: rebuildGalleryImage,
    alt: "仲間と古民家の屋根瓦を下ろしている様子",
    caption: "ひとりではできないことを、みんなで。",
    className: "gallery-card--portrait",
  },
  {
    image: interiorImage,
    alt: "光が差し込む古民家の室内",
    caption: "古いものを残しながら、使える場所へ。",
    className: "",
  },
  {
    image: welcomingGalleryImage,
    alt: "仲間と古民家の室内を直している様子",
    caption: "直すだけでなく、人が訪れるきっかけを。",
    className: "",
  },
  {
    image: tableImage,
    alt: "古民家の食卓に料理が並び、人が集まっている様子",
    caption: "食卓を囲む時間が、この家の日常になりました。",
    className: "gallery-card--portrait",
  },
  {
    image: activityBaseImage,
    alt: "古民家で開かれた催しに人が集まっている様子",
    caption: "神浦港から歩いて約2分。島での活動拠点です。",
    className: "gallery-card--tall",
  },
];
---

<BaseLayout
  title="古民家を直し、ひらく"
  description="中島で受け取った築100年の古民家を、仲間と少しずつ直し、人が集まる場所へ育ててきた記録です。"
>
  <article class="kominka-page">
    <YanoSpeechBubble size="map" />
    <header class="kominka-hero">
      <div class="kominka-hero__copy">
        <p class="eyebrow">KOMINKA PROJECT / NAKAJIMA</p>
        <h1>扉の向こうに、<br /><span class="word-keep">もうひとつの暮らし。</span></h1>
        <p class="kominka-hero__lead">
          2円で受け取った築100年の家。<br />
          週末ごとに手を入れています。
        </p>
      </div>
      <a class="kominka-door" href="#story-title" data-kominka-door>
        <span class="kominka-door__light" aria-hidden="true"></span>
        <span class="kominka-door__photo">
          <img src={interiorImage.src} alt="扉の向こうに見える古民家の室内" />
        </span>
        <img class="kominka-door__frame" src="/images/kominka/door-frame.png" alt="" aria-hidden="true" />
        <span class="kominka-door__cta">古民家をのぞく <b aria-hidden="true">→</b></span>
      </a>
    </header>

    <section class="story-section" aria-labelledby="story-title">
      <figure class="story-section__photo">
        <img src="/images/kominka/story-roof-work.png" alt="雨の中で古民家の屋根瓦を下ろした作業日の記念写真" />
      </figure>
      <div class="story-section__copy">
        <div class="section-heading">
          <p class="eyebrow">THE BEGINNING</p>
          <h2 id="story-title">残したい風景に、自分の手で関わってみる。</h2>
        </div>
        <div class="story-card">
          <p>
            大学時代に田舎を訪れ、その風景や人の暮らしに惹かれました。一方で、人口が減り、使われなくなった家や地域の営みが少しずつ失われていく現実も知りました。
          </p>
          <p>
            大きな言葉で地域を変えるのではなく、まずは目の前にある風景と関わり続けたい。そんな思いから、中島で出会った築100年の古民家を受け取りました。
          </p>
          <p>
            建築の専門家でも、DIYの達人でもありません。分からないことは島の人や仲間に教わり、壊して、迷って、また直す。週末ごとの小さな積み重ねが、家との関係をつくっています。
          </p>
        </div>
      </div>
    </section>

    <section class="process-section" aria-labelledby="process-title">
      <header class="section-heading section-heading--center">
        <p class="eyebrow">HOW WE REBUILD</p>
        <h2 id="process-title">直しながら、ひらいていく。</h2>
        <p>完成を待つのではなく、その途中から人が関われる場所にしています。</p>
      </header>
      <ol class="process-list">
        <li class="paper-card">
          <figure><img src={clearingRoomImage.src} alt="片づけと解体を始めた古民家の室内" loading="eager" /></figure>
          <div class="process-list__copy">
            <div class="process-list__heading"><span>01</span><h3>まず、片づける</h3></div>
            <p>
              長く積もったものを運び出し、床や壁の状態を確かめるところから始めました。
            </p>
          </div>
        </li>
        <li class="paper-card">
          <figure><img src={rebuildingTogetherImage.src} alt="古民家の室内で仲間と修繕作業を進める様子" loading="eager" /></figure>
          <div class="process-list__copy">
            <div class="process-list__heading"><span>02</span><h3>教わりながら直す</h3></div>
            <p>
              屋根、天井、キッチン。島の人や職人、仲間の力を借りて、ひとつずつ手を入れています。
            </p>
          </div>
        </li>
        <li class="paper-card">
          <figure><img src={welcomingPeopleImage.src} alt="KominKaの前に集まった島内外の仲間たち" loading="eager" /></figure>
          <div class="process-list__copy">
            <div class="process-list__heading"><span>03</span><h3>人を迎える</h3></div>
            <p>
              作業の日も、食卓を囲む日も。家に人が集まり、新しい思い出が重なっています。
            </p>
          </div>
        </li>
      </ol>
    </section>

    <section class="gallery-section" aria-labelledby="gallery-title">
      <header class="gallery-section__heading">
        <p class="eyebrow">SCENES FROM KOMINKA</p>
        <h2 id="gallery-title">古民家の、いままでと今。</h2>
        <p>
          直す人、訪れる人、食卓を囲む人。家に残っていく時間を写真で紹介します。
        </p>
      </header>
      <div class="gallery-grid">
        {
          gallery.map((item) => (
            <figure class={`gallery-card paper-photo ${item.className}`}>
              <img src={item.image.src} alt={item.alt} loading="eager" />
              <figcaption>{item.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section class="now-section" aria-labelledby="now-title">
      <div class="now-section__copy">
        <p class="eyebrow">KOMINKA TODAY</p>
        <h2 id="now-title">未完成のまま、人が集まれる場所に。</h2>
        <p>
          屋号は「しとらすすたんどKominKa」。島での活動拠点として、週末を中心に手入れを続けています。不定期の催しや作業日には、島の内外から人が集まります。
        </p>
        <p>
          見学や活動に興味がある方は、まず日々の記録をご覧ください。予定が合うときには、島や古民家をご案内します。
        </p>
      </div>
      <nav class="now-section__links" aria-label="古民家についてもっと見る">
        <a href="/no-plan-project/">
          <span><small>VIDEO SERIES</small>古民家再生の全9話を見る</span>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/#access">
          <span><small>ACCESS</small>中島への行き方を見る</span>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/">
          <span><small>BACK TO HOME</small>トップページへ戻る</span>
          <b aria-hidden="true">→</b>
        </a>
      </nav>
    </section>
  </article>

  <script>
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLAnchorElement>("[data-kominka-door]").forEach((door) => {
      door.addEventListener("click", (event) => {
        if (reducedMotion.matches || door.classList.contains("is-entering")) return;
        event.preventDefault();
        door.classList.add("is-entering");
        window.setTimeout(() => {
          window.location.href = door.href;
        }, 950);
      });
    });

    window.addEventListener("pageshow", () => {
      document.querySelectorAll("[data-kominka-door].is-entering").forEach((door) => {
        door.classList.remove("is-entering");
      });
    });
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #36a9ee;
  }

  :global(body:has(.kominka-page)) {
    --site-frame-space: clamp(8px, .7vw, 10px);
  }

  :global(body:has(.kominka-page) .site-header) {
    display: none;
  }

  .kominka-page {
    --blue: #36a9ee;
    --navy: #30486e;
    --yellow: #ffe052;
    --paper: #fffdf4;
    position: relative;
    overflow: clip;
    background: var(--blue);
    color: white;
  }

  .word-keep {
    white-space: nowrap;
  }

  .kominka-hero,
  .story-section,
  .process-section,
  .gallery-section,
  .now-section {
    width: min(calc(100% - clamp(2.5rem, 6vw, 5rem)), 1160px);
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--yellow);
    font-family: "Noto Sans", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  h1,
  h2,
  h3,
  p {
    overflow-wrap: break-word;
    word-break: normal;
  }

  h1,
  h2 {
    margin: 0;
    font-family: "Noto Serif JP", serif;
    font-weight: 500;
    letter-spacing: 0.03em;
  }

  .kominka-hero {
    position: relative;
    min-height: 0;
    padding-block: clamp(20rem, 23vw, 22rem) clamp(5rem, 6.5vw, 6rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }


  .kominka-hero h1 {
    max-width: 11em;
    font-size: clamp(3rem, 3.75vw, 3.375rem);
    line-height: 1.4;
    text-wrap: balance;
  }

  .kominka-hero__lead {
    max-width: 36rem;
    margin: 1.6rem 0 0;
    font-size: 1rem;
    line-height: 1.9;
  }

  .paper-photo,
  .paper-card {
    position: relative;
    z-index: 0;
    color: var(--navy);
    background: var(--paper);
    border: 2px solid var(--navy);
    box-shadow: 12px 14px 0 var(--yellow);
  }

  .kominka-hero__photo {
    margin: 0;
    padding: clamp(0.55rem, 1vw, 0.9rem);
    transform: rotate(1.2deg);
  }

  .paper-photo img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .kominka-hero__photo img {
    aspect-ratio: auto;
  }

  .paper-photo figcaption {
    padding: 0.8rem 0.35rem 0.3rem;
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .story-section {
    position: relative;
    padding-block: clamp(5rem, 6.5vw, 6rem);
    display: block;
    color: var(--navy);
    background: var(--paper);
    box-shadow: 0 0 0 100vmax var(--paper);
    clip-path: inset(0 -100vmax);
  }

  .story-section::before,
  .story-section::after {
    position: absolute;
    left: 50%;
    z-index: 1;
    width: 100vw;
    height: clamp(2rem, 3vw, 2.75rem);
    background: url("/images/decor/kominka-wave-divider.svg") repeat-x center / auto 100%;
    content: "";
    pointer-events: none;
  }

  .story-section::before {
    top: 0;
    transform: translateX(-50%);
  }

  .story-section::after {
    bottom: 0;
    transform: translateX(-50%) rotate(180deg);
  }

  .story-section > * {
    position: relative;
    z-index: 2;
  }

  .section-heading h2,
  .gallery-section h2,
  .now-section h2 {
    max-width: none;
    font-size: clamp(2rem, 2.5vw, 2.375rem);
    line-height: 1.45;
    text-wrap: balance;
  }

  .story-section > .section-heading,
  .process-section > .section-heading,
  .gallery-section__heading {
    text-align: left;
  }

  .story-card {
    max-width: 45rem;
    margin: clamp(2.5rem, 4vw, 3rem) 0 0;
    padding: clamp(2.5rem, 3.5vw, 3rem);
    transform: rotate(-0.45deg);
  }

  .story-card p,
  .now-section__copy > p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.9;
  }

  .story-card p + p,
  .now-section__copy > p + p {
    margin-top: 1.5rem;
  }

  .process-section {
    padding-block: clamp(5rem, 6.5vw, 6rem);
  }

  .section-heading--center {
    max-width: none;
    margin-inline: 0;
    text-align: left;
  }

  .section-heading--center > p:last-child,
  .gallery-section__heading > p:last-child {
    max-width: 46rem;
    margin: 1.5rem 0 0;
    line-height: 1.9;
  }

  .process-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: clamp(2.5rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .process-list li {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 0;
    padding: 0;
    overflow: hidden;
  }

  .process-list figure {
    display: grid;
    place-items: center;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 2px solid var(--navy);
    background: #eee9dc;
  }

  .process-list figure img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .process-list__copy {
    padding: clamp(1.75rem, 2.4vw, 2rem);
  }

  .process-list__copy > span {
    display: grid;
    place-items: center;
    width: 3.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--yellow);
    font:
      500 0.78rem/1 "Noto Sans",
      sans-serif;
  }

  .process-list h3 {
    margin: 1.5rem 0 1rem;
    font-family: "Noto Serif JP", serif;
    font-size: clamp(1.375rem, 1.65vw, 1.5rem);
    font-weight: 500;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .process-list p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.9;
  }

  .gallery-section {
    padding-block: clamp(5rem, 6.5vw, 6rem);
  }

  .gallery-section__heading {
    display: block;
    margin-bottom: clamp(2.5rem, 4vw, 3rem);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3vw, 2.5rem);
    align-items: start;
  }

  .gallery-card {
    grid-column: auto;
    margin: 0;
    padding: 0.6rem;
  }

  .gallery-card:nth-child(2n) {
    grid-column: auto;
    transform: rotate(0.35deg);
  }
  .gallery-card:nth-child(3n) {
    grid-column: auto;
    transform: rotate(-0.3deg);
  }
  .gallery-card--wide {
    grid-column: auto;
  }

  .gallery-card img,
  .gallery-card--portrait img,
  .gallery-card--tall img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .now-section {
    padding-block: clamp(5rem, 6.5vw, 6rem);
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(20rem, 1.12fr);
    gap: clamp(3rem, 5vw, 4rem);
    align-items: start;
  }

  .now-section__copy > p:first-of-type {
    margin-top: 2rem;
  }

  .now-section__links {
    display: grid;
    gap: 1rem;
  }

  .now-section__links a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    min-height: 72px;
    padding: 0.75rem 1.25rem;
    color: var(--navy);
    background: var(--paper);
    border: 2px solid var(--navy);
    box-shadow: 7px 8px 0 var(--yellow);
    text-decoration: none;
    transition:
      translate 180ms ease,
      box-shadow 180ms ease;
  }

  .now-section__links a:hover,
  .now-section__links a:focus-visible {
    translate: 3px 3px;
    box-shadow: 4px 5px 0 var(--yellow);
  }

  .now-section__links a:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
  }

  .now-section__links small {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.62rem;
    letter-spacing: 0.17em;
  }

  .now-section__links b {
    font-size: 1.5rem;
    font-weight: 400;
  }

  @media (max-width: 900px) {
    .kominka-hero,
    .story-section,
    .now-section {
      grid-template-columns: 1fr;
    }

    .kominka-hero {
      min-height: auto;
      padding: 20rem 0 4.5rem;
    }
    .kominka-hero__copy {
      max-width: 42rem;
    }
    .story-section {
      gap: 3rem;
    }
    .process-list {
      grid-template-columns: 1fr;
    }
    .process-list li {
      grid-template-columns: minmax(0, 45%) minmax(0, 55%);
      grid-template-rows: 1fr;
      min-height: auto;
    }
    .process-list li:nth-child(2) {
      transform: rotate(0.4deg);
    }
    .gallery-section__heading {
      display: block;
    }
    .gallery-card,
    .gallery-card--wide,
    .gallery-card:nth-child(2n),
    .gallery-card:nth-child(3n) {
      grid-column: span 6;
    }
  }

  @media (max-width: 600px) {
    :global(body:has(.kominka-page)) {
      --site-frame-space: 5px;
    }

    .kominka-hero,
    .story-section,
    .process-section,
    .gallery-section,
    .now-section {
      width: min(calc(100% - 2.5rem), 1240px);
    }

    .kominka-hero {
      padding: 14.5rem 0 4rem;
      gap: 2.5rem;
    }
    .kominka-hero h1 {
      max-width: 11em;
      font-size: 2.125rem;
      line-height: 1.45;
    }
    .kominka-hero__lead br {
      display: none;
    }
    .paper-photo,
    .paper-card {
      box-shadow: 7px 8px 0 var(--yellow);
    }
    .story-card {
      padding: 1.75rem 1.35rem;
    }
    .eyebrow {
      font-size: 0.72rem;
    }
    .story-section,
    .process-section,
    .gallery-section,
    .now-section {
      padding-block: 4rem;
    }
    .section-heading h2,
    .gallery-section h2,
    .now-section h2 {
      font-size: 1.75rem;
      line-height: 1.5;
    }
    .story-card p,
    .now-section__copy > p,
    .section-heading--center > p:last-child,
    .gallery-section__heading > p:last-child {
      font-size: 0.95rem;
    }
    .section-heading--center {
      text-align: left;
    }
    .process-list {
      margin-top: 2.5rem;
      gap: 2rem;
    }
    .process-list li {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
    }
    .process-list figure {
      aspect-ratio: 3 / 2;
    }
    .process-list__copy {
      padding: 1.35rem;
    }
    .process-list__copy > span {
      width: 2.75rem;
    }
    .process-list h3 {
      margin: 1rem 0 0.75rem;
      font-size: 1.3125rem;
    }
    .process-list p {
      font-size: 0.95rem;
    }
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .gallery-card,
    .gallery-card--wide,
    .gallery-card:nth-child(2n),
    .gallery-card:nth-child(3n) {
      grid-column: 1;
      transform: none;
    }
    .now-section {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .now-section__links a {
      min-height: 52px;
      padding: 0.75rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kominka-hero__photo,
    .story-card,
    .process-list li,
    .gallery-card {
      transform: none;
    }

    .now-section__links a {
      transition: none;
    }
  }

  /* Story-like entrance: an open kominka door leading into the existing page. */
  .kominka-page {
    border-top: 4px solid var(--yellow);
  }

  .kominka-hero {
    box-sizing: border-box;
    width: 100%;
    min-height: calc(100svh - 4px);
    padding: clamp(9.5rem, 13vh, 11rem) clamp(3rem, 7vw, 7rem) clamp(5rem, 8vh, 7rem);
    grid-template-columns: minmax(22rem, 0.78fr) minmax(34rem, 1.22fr);
    gap: clamp(2rem, 4vw, 5rem);
    overflow: hidden;
  }

  .kominka-hero__copy {
    position: relative;
    z-index: 4;
    align-self: center;
