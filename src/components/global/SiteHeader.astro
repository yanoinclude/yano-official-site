---
import { primaryNavigation } from "@/content/pages/navigation";
import { siteConfig } from "@/content/pages/site";

const currentPath = Astro.url.pathname;
---

<header class="site-header" data-site-header>
  <a class="site-logo" href="/" aria-label={`${siteConfig.name} トップページ`}>
    {siteConfig.name}
  </a>

  <button
    class="menu-button"
    type="button"
    aria-expanded="false"
    aria-controls="site-navigation"
    aria-label="メニューを開く"
    data-menu-button
  >
    <span class="menu-button__label">メニュー</span>
    <span class="menu-button__line" aria-hidden="true"></span>
  </button>

  <div class="site-nav-backdrop" data-menu-backdrop aria-hidden="true"></div>

  <nav
    class="site-nav"
    id="site-navigation"
    aria-label="主要ナビゲーション"
    data-site-nav
  >
    <ul>
      {
        primaryNavigation.map((item) => {
          const isCurrent =
            !item.external &&
            item.href !== "/#activities" &&
            item.href.replace(/\/$/, "") === currentPath.replace(/\/$/, "");

          return (
            <li>
              <a
                href={item.href}
                class:list={{ "site-nav__product": item.accent }}
                aria-current={isCurrent ? "page" : undefined}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
                {item.external && <span aria-hidden="true">↗</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector("[data-site-header]");
  const button = document.querySelector("[data-menu-button]");
  const nav = document.querySelector("[data-site-nav]");
  const backdrop = document.querySelector("[data-menu-backdrop]");
  let previouslyFocused: Element | null = null;

  const getFocusableItems = () =>
    nav
      ? Array.from(nav.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"))
      : [];

  const setMenu = (open: boolean, restoreFocus = true) => {
    if (!(button instanceof HTMLButtonElement)) return;

    if (open) {
      previouslyFocused = document.activeElement;
    }

    button.setAttribute("aria-expanded", String(open));
    button.setAttribute("aria-label", open ? "メニューを閉じる" : "メニューを開く");
    header?.toggleAttribute("data-menu-open", open);
    document.documentElement.toggleAttribute("data-menu-open", open);

    if (open) {
      window.setTimeout(() => getFocusableItems()[0]?.focus(), 280);
    } else if (restoreFocus) {
      (previouslyFocused instanceof HTMLElement ? previouslyFocused : button).focus();
    }
  };

  button?.addEventListener("click", () => {
    setMenu(button.getAttribute("aria-expanded") !== "true");
  });

  nav?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a")) {
      setMenu(false, false);
    }
  });

  backdrop?.addEventListener("click", () => setMenu(false));

  document.addEventListener("keydown", (event) => {
    if (!header?.hasAttribute("data-menu-open")) return;

    if (event.key === "Escape") {
      event.preventDefault();
      setMenu(false);
      return;
    }

    if (event.key !== "Tab") return;
    const focusable = [button, ...getFocusableItems()].filter(
      (item): item is HTMLElement => item instanceof HTMLElement,
    );
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });

  window.addEventListener("resize", () => {
    if (window.matchMedia("(min-width: 1121px)").matches) {
      setMenu(false, false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky !important;
    top: 0;
    left: auto;
    box-sizing: border-box;
    width: 100%;
    height: 76px !important;
    padding: 0 clamp(1.5rem, 3vw, 3rem) !important;
    border-bottom: 1px solid rgb(46 69 104 / 18%) !important;
    background: rgb(255 253 244 / 96%) !important;
    color: #2e4568 !important;
    backdrop-filter: blur(14px) !important;
  }

  .site-logo {
    flex: 0 0 auto;
    font-size: clamp(1.08rem, 1.4vw, 1.28rem) !important;
    font-weight: 500 !important;
    white-space: nowrap;
  }

  .site-nav {
    margin-left: 2rem;
  }

  .site-nav ul {
    flex-wrap: nowrap;
    gap: clamp(0.85rem, 1.35vw, 1.35rem);
  }

  .site-nav li,
  .site-nav a {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    min-height: 44px;
    color: #2e4568 !important;
    font-size: clamp(0.75rem, 0.82vw, 0.84rem) !important;
    letter-spacing: 0.03em !important;
  }

  .site-nav__product {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding-inline: 1.1rem;
    border: 1.5px solid #111;
    border-radius: 0.45rem;
    background: var(--island-lemon);
    color: #182f50 !important;
  }

  .site-nav-backdrop {
    display: none;
  }

  @media (max-width: 1120px) {
    .site-header {
      height: 68px !important;
      padding:
        env(safe-area-inset-top)
        max(1.25rem, env(safe-area-inset-right))
        0
        max(1.25rem, env(safe-area-inset-left)) !important;
    }

    .menu-button {
      position: relative;
      z-index: 2;
      display: inline-flex !important;
      min-width: 48px;
      min-height: 48px;
      color: #2e4568 !important;
    }

    .menu-button__line {
      position: relative;
    }

    .menu-button__line::before,
    .menu-button__line::after {
      position: absolute;
      top: 0;
      left: 0;
    }

    .site-header[data-menu-open] .menu-button__line {
      background: transparent !important;
    }

    .site-header[data-menu-open] .menu-button__line::before {
      transform: rotate(45deg) !important;
    }

    .site-header[data-menu-open] .menu-button__line::after {
      transform: rotate(-45deg) !important;
    }

    .site-nav-backdrop {
      position: absolute;
      z-index: 0;
      top: 100%;
      right: 0;
      left: 0;
      display: block;
      width: 100%;
      height: calc(100dvh - 68px);
      visibility: hidden;
      background: rgb(24 47 80 / 35%);
      opacity: 0;
      transition: opacity 220ms ease, visibility 220ms ease;
    }

    .site-header[data-menu-open] .site-nav-backdrop {
      visibility: visible;
      opacity: 1;
    }

    .site-nav {
      position: absolute !important;
      z-index: 1;
      top: 100% !important;
      right: 0;
      bottom: auto;
      left: auto !important;
      display: block !important;
      box-sizing: border-box;
      width: min(88vw, 27rem);
      height: calc(100dvh - 68px);
      margin: 0;
      padding:
        1rem
        max(1.5rem, env(safe-area-inset-right))
        max(1.5rem, env(safe-area-inset-bottom))
        1.5rem !important;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: #fffdf4 !important;
      color: #2e4568;
      visibility: hidden;
      transform: translateX(100%);
      transition: transform 260ms ease, visibility 260ms ease;
    }

    .site-header[data-menu-open] .site-nav {
      visibility: visible;
      transform: translateX(0);
    }

    .site-nav ul {
      display: grid !important;
      gap: 0 !important;
    }

    .site-nav a {
      box-sizing: border-box;
      width: 100%;
      min-height: 56px;
      padding: 0.75rem 0 !important;
      border-bottom: 1px solid rgb(46 69 104 / 18%);
      font-size: 1rem !important;
      letter-spacing: 0.06em !important;
    }

    .site-nav a::after {
      content: none !important;
    }

    .site-nav__product {
      margin-top: 1rem;
      padding-inline: 1.25rem !important;
      border: 1.5px solid #111 !important;
      border-radius: 0.45rem;
      background: var(--island-lemon) !important;
    }
  }

  @media (max-width: 480px) {
    .menu-button__label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .site-logo {
      font-size: 1rem !important;
    }
  }
</style>
